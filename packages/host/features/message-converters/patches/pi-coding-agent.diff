+/** A custom or hook message as stored in history, before model conversion. */
+export type ConvertibleCustomMessage = Extract<AgentMessage, { role: "custom" | "hookMessage" }>;
+
+/**
+ * Converts one custom message type to model messages. Return `undefined` to
+ * fall back to the native conversion for that message.
+ */
+export type CustomMessageConverter = (message: ConvertibleCustomMessage) => Message[] | undefined;
+
+const customMessageConverters = new Map<string, CustomMessageConverter>();
+
+/** Drop every memoized conversion so a converter change applies to restored history too. */
+function resetConversionCaches(): void {
+	convertCache = new WeakMap<AgentMessage, ConvertMemoEntry>();
+	convertGeneration++;
+}
+
+/**
+ * Register how messages of `customType` reach the model, process-wide (every
+ * session and subagent in this process converts through the same table).
+ * Registering the same type again replaces its converter. Conversion applies
+ * at model-context build time, so stored history keeps its native custom type.
+ * Returns a function that removes this converter if it is still the active one.
+ */
+export function registerCustomMessageConverter(customType: string, converter: CustomMessageConverter): () => void {
+	if (typeof customType !== "string" || customType.length === 0) throw new TypeError("customType must be a non-empty string");
+	if (typeof converter !== "function") throw new TypeError("converter must be a function");
+	customMessageConverters.set(customType, converter);
+	resetConversionCaches();
+	return () => {
+		if (customMessageConverters.get(customType) !== converter) return;
+		customMessageConverters.delete(customType);
+		resetConversionCaches();
+	};
+}
+
+/** Registered conversion for one message; a throwing converter falls back to native conversion. */
+function convertRegisteredCustomMessage(message: ConvertibleCustomMessage): Message[] | undefined {
+	const converter = customMessageConverters.get(message.customType);
+	if (!converter) return undefined;
+	try {
+		return converter(message);
+	} catch (error) {
+		logger.warn("Custom message converter failed; using native conversion", { customType: message.customType, error: String(error) });
+		return undefined;
+	}
+}
