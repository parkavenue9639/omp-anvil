diff --git a/src/cli/startup-prepaint.ts b/src/cli/startup-prepaint.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4e7928c73427e928964d458b3f0ab453c48b2c8b
--- /dev/null
+++ b/src/cli/startup-prepaint.ts
@@ -0,0 +1,31 @@
+import { isAbsolute } from "node:path";
+
+const SAFE_SWITCHES: Record<string, true> = {
+	"--no-session": true,
+	"--no-extensions": true,
+	"--no-skills": true,
+	"--no-rules": true,
+	"--no-context-files": true,
+	"--no-tools": true,
+	"--no-lsp": true,
+	"--no-title": true,
+	"--no-prewalk": true,
+	"--no-pty": true,
+};
+
+/** Only known, message-free interactive launches may acquire speculative stdin. */
+export function isStartupPrepaintSafe(argv: readonly string[]): boolean {
+	for (let index = 0; index < argv.length; index++) {
+		const argument = argv[index];
+		if (SAFE_SWITCHES[argument] === true) continue;
+		const equals = argument.indexOf("=");
+		const flag = equals < 0 ? argument : argument.slice(0, equals);
+		if (flag !== "--config" && flag !== "--trusted-extension") return false;
+		const value = equals < 0 ? argv[++index] : argument.slice(equals + 1);
+		// Do not swallow a mode switch, separator, or malformed value. Full CLI
+		// validation (and trusted-extension loading) still runs before activation.
+		if (!value || value.startsWith("-")) return false;
+		if (flag === "--trusted-extension" && !isAbsolute(value)) return false;
+	}
+	return true;
+}
