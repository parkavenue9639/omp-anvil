+	"source-events.v1": true, "router-generation-v1": true, "before-provider-cancel-v1": true, "router-handoff-wait-v1": true, "completion-human-preservation-v1": true, "silent-notice-v1": true, "session-lifecycle-control-v1": true });
+export type ExecutorTarget =
+	| { kind: "executor"; ticketId: string; assignmentId: string; claimEpoch: number }
+	| { kind: "router-generation"; generation: number; roleInboxId: string; claimEpoch: number; prepared?: boolean };
+export interface ExecutorInput {
+	id: string; ticketId?: string; kind: string; text: string; triggerId?: string; answerToReportId?: string; createdSeq: number;
+}
+export interface ExecutorInputReceipt {
+	inputId: string; target: ExecutorTarget; admissionSeq: number; queuedAt: string;
+	sessionFile?: string;
+	historyEntryId?: string; historyAt?: string; turnId?: string; turnCompletedAt?: string; purgedAt?: string;
+}
+export interface ExecutorTurnContext {
+	target?: ExecutorTarget; turnId?: string; admissionSeq: number; inputWatermark: number;
+	consumedInputIds: string[]; unadmittedUserEntryIds: string[];
+	pendingHumanSubmissionIds: string[];
+	orphanedHumanSubmissions: { id: string; text: string; target: ExecutorTarget }[];
+}
+export type ExecutorStopReason = "completed" | "human-stop" | "retry" | "scope-replaced" | "host-shutdown";
+export interface ExecutorStopReceipt {
+	assignmentId?: string; target: ExecutorTarget; instanceId: string; gateClosedAt: string; turnAborted: boolean;
+	purgedInputIds: string[]; jobsEnded: string[]; subagentsEnded: string[]; quiescedAt: string;
+	reason: ExecutorStopReason; throughAdmissionSeq?: number; retainedHumanInputIds: string[]; pendingHumanSubmissionIds: string[];
+}
+export interface ExecutorSourceEvent { seq: number; type: string; at: string; data: unknown }
+export interface SessionControlRequest { action: "continue" | "close"; requestId: string }
+export interface SessionControlReceipt { status: "queued" | "closing" | "blocked"; reason?: string; observedAt: string; historyEntryId?: string; historyAt?: string }
+export interface NativeSessionActivity {
+	runningJobs: number; runningProcesses: number; runningSubagents: number; pendingHumanAdmissions: number; closing: boolean;
+}
+const SESSION_CONTINUE_TEXT = "Router coordination request (machine-origin, not a human instruction or new authorization). Review this session's original context and verify the results of any interrupted actions before proceeding. Continue only unfinished work that is still authorized. Do not repeat completed actions or blindly replay an interrupted tool batch. If work is completed, stopped, or waiting for a human decision, report the current state only; do not invent permission or start new work.";
+type StoredInput = { input: ExecutorInput; fingerprint: string; receipt: ExecutorInputReceipt; human?: boolean; wake?: false };
+type LifecycleRecord =
+	| { type: "sessionContinue" | "sessionContinueState"; requestId: string; receipt: SessionControlReceipt }
+	| { type: "bind"; target: ExecutorTarget; baselineJobIds: string[]; baselineSubagentIds: string[] }
+	| { type: "admit"; inputs: StoredInput[] }
+	| { type: "humanSubmission"; id: string; text: string; target: ExecutorTarget }
+	| { type: "humanSubmissionHandled"; id: string }
+	| { type: "unadmittedResolved"; entryIds: string[]; humanSubmissionIds: string[] }
+	| { type: "history"; inputId: string; entryId: string; at: string; turnId?: string }
+	| { type: "humanRetained"; inputIds: string[] }
+	| { type: "humanTaken"; inputIds: string[]; turnId: string }
+	| { type: "inputTaken"; inputIds: string[]; turnId: string }
+	| { type: "purge"; inputIds: string[]; at: string }
+	| { type: "retarget"; inputIds: string[]; target: ExecutorTarget; reconciledHistory?: true }
+	| { type: "turnCompleted"; turnId: string; inputIds: string[]; stopReason: string; willContinue: boolean; at: string; runningJobs: number }
+	| { type: "gateClosed"; target: ExecutorTarget; at: string; reason?: ExecutorStopReason; throughAdmissionSeq?: number }
+	| { type: "quiesced"; receipt: ExecutorStopReceipt };
