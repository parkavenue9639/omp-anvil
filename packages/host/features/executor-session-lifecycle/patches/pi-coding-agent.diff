+const STOP_JOIN_TIMEOUT_MS = 10_000;
+export function executorInputId(message: { role?: string; details?: unknown; executorInputId?: string }): string | undefined {
+	if (message.role === "custom" || message.role === undefined) {
+		const details = message.details;
+		return details && typeof details === "object" && "executorInputId" in details &&
+			typeof details.executorInputId === "string" ? details.executorInputId : undefined;
+	}
