+}
+function targetKey(target: ExecutorTarget): string {
+	return target.kind === "executor" ? JSON.stringify([target.kind, target.ticketId, target.assignmentId, target.claimEpoch]) :
+		JSON.stringify([target.kind, target.generation, target.roleInboxId, target.claimEpoch]);
+}
+
+/** Native journal is authoritative. The index is rebuilt once per session, never on probe/admission. */
