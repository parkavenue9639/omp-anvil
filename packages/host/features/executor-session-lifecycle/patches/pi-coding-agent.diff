+	#pendingNotices = new Set<string>();
+	#flushingNotices = false;
+	#sessionControls = new Map<string, SessionControlReceipt>();
+	#queuedSessionControls = new Set<string>();
+	#sessionControlHistory = new Map<string, { historyEntryId: string; historyAt: string }>();
+	constructor(private readonly manager: SessionManager, private readonly host: ExecutorLifecycleHost) {
+		this.#sessionId = manager.getSessionId();
+		this.#rebuildIndex();
+		// Targets are instance capabilities: restart requires an explicit trusted bind.
+		this.#target = undefined;
+		this.#closed = false;
+	}
+	/** After the native manager reloads this journal; commits still require its own writer lease. */
