+		scope: { enum: ["project", "global", null] },
+		projectId: { type: ["string", "null"] },
+		content: { type: "string" },
+		sourceRefs: { type: "array", minItems: 1, items: { type: "string", minLength: 1 } },
+		reason: { type: "string", minLength: 1 },
