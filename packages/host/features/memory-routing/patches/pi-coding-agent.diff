+				// Race the whole native attempt, observing late settlement without admitting it.
+				response = await untilAborted(signal, async () => {
+					const headers = await context.modelRegistry.resolveModelHeaders(model, signal);
+					signal.throwIfAborted();
+					if (context.budget) {
+						context.budget.modelCalls = 1;
+						context.budget.reservedInputChars = inputChars;
+						context.budget.reservedOutputTokens = Math.max(context.budget.reservedOutputTokens, maxTokens);
+					}
+					const stream = streamSimple(model, {
+						systemPrompt: [SYSTEM],
+						messages: [{ role: "user", content: [{ type: "text", text: payload }], timestamp: Date.now() }],
+					}, {
+						apiKey: context.modelRegistry.resolver(model, context.sessionId), headers,
+						sessionId: context.sessionId, signal,
+						// High-effort reasoning shares the output budget with the visible JSON.
+						maxTokens,
+						reasoning: clampThinkingLevelForModel(model, toReasoningEffort(thinking)),
+						disableReasoning: shouldDisableReasoning(thinking), maxHttpAttempts: 1,
+					});
+					for await (const _event of stream) signal.throwIfAborted();
+					const result = await stream.result();
+					signal.throwIfAborted();
+					return result;
+				});
+			} catch (error) {
+				if (context.signal?.aborted) return [pendingMemoryDecision(input, "Memory classification was cancelled")];
+				const usageLimit = AIError.is(AIError.classifyMessage({
+					api: model.api, errorMessage: error instanceof Error ? error.message : String(error),
+				}), AIError.Flag.UsageLimit);
+				if (!retryFallbackAdmits(retry.fallbackOn, usageLimit)) break;
+				continue;
+			}
+			if (response.stopReason === "error") {
+				const classified = AIError.classifyMessage(response);
+				if (AIError.is(classified, AIError.Flag.ThinkingLoop)) return [pendingMemoryDecision(input, "Memory classification stalled; review or retry required")];
+				if (!retryFallbackAdmits(retry.fallbackOn, AIError.is(classified, AIError.Flag.UsageLimit))) break;
+				continue;
+			}
+			// A completed answer is terminal: never seek a different answer after malformed JSON or truncation.
+			if (response.stopReason !== "stop") return [pendingMemoryDecision(input, `Memory classification did not complete (${response.stopReason})`)];
+			const text = response.content.filter(part => part.type === "text").map(part => part.text).join("\n").trim();
+			// Accept only a complete JSON fence; prose, partial fences and invalid inner JSON remain errors.
+			const fenced = JSON_RESPONSE_FENCE.exec(text);
+			const parsed: unknown = JSON.parse(fenced ? fenced[1] : text);
+			if (!isRecord(parsed) || Object.keys(parsed).length !== 1 || !Object.hasOwn(parsed, "decisions")) {
+				return [pendingMemoryDecision(input, "Invalid classification response schema")];
+			}
+			// Model wire schema requires explicit nullable destination fields; service callers use optional fields.
+			if (!Array.isArray(parsed.decisions) || parsed.decisions.some(item => !isRecord(item) || Object.keys(item).length !== 6 || !Object.hasOwn(item, "scope") || !Object.hasOwn(item, "projectId"))) {
+				return [pendingMemoryDecision(input, "Invalid classification decision schema")];
+			}
+			const decoded = parsed.decisions.map(item => {
+				if (!isRecord(item) || !Array.isArray(item.sourceRefs)) return item;
+				return {
+					...item,
+					sourceRefs: item.sourceRefs.map(ref => typeof ref === "string" ? sourceRefsByToken.get(ref) ?? ref : ref),
+				};
+			});
+			return validateMemoryRoutingDecisions(context, input, decoded);
+		}
+		return [pendingMemoryDecision(input, "Configured memory classification candidates failed; review or retry required")];
+	} catch {
+		// Provider errors may embed prompts or credential-bearing URLs. Keep only a safe failure code.
+		return [pendingMemoryDecision(input, "Memory classification failed; review or retry required")];
+	}
+}
diff --git a/src/memory-routing/ledger.ts b/src/memory-routing/ledger.ts
new file mode 100644
index 0000000000000000000000000000000000000000..625618eb8b744bbcfbe05a2f3fbd5b58862be33b
--- /dev/null
+++ b/src/memory-routing/ledger.ts
@@ -0,0 +1,174 @@
+import { Database } from "bun:sqlite";
+import { createHash } from "node:crypto";
+import { chmodSync, existsSync, mkdirSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { getMemoriesDir } from "@oh-my-pi/pi-utils";
+import { redactRoutingSecrets } from "./redact";
+import type { MemoryRoutingContext, MemoryRoutingDecision, MemoryRoutingInput, MemoryRoutingLedgerEntry, MemoryRoutingStored } from "./types";
+
+const queues = new Map<string, Promise<void>>();
+
+/** Native admission and migration share the target memory store's routing ledger namespace. */
+export function memoryRoutingLedgerAgentDir(dbPath: string): string {
+	return join(dirname(resolve(dbPath)), ".routing-agent");
+}
+
+/** Serialize writers in a host process, including different sources targeting the same fact. */
+export async function withMemoryRoutingLock<T>(agentDir: string, run: () => Promise<T>): Promise<T> {
+	const path = join(getMemoriesDir(agentDir), "routing", "ledger.db");
+	const prior = queues.get(path) ?? Promise.resolve();
+	const done = Promise.withResolvers<void>();
+	const current = prior.then(() => done.promise);
+	queues.set(path, current);
+	await prior;
+	try {
+		return await run();
+	} finally {
+		done.resolve();
+		if (queues.get(path) === current) queues.delete(path);
+	}
+}
+
+function openLedger(agentDir: string): Database {
+	const directory = join(getMemoriesDir(agentDir), "routing");
+	mkdirSync(directory, { recursive: true, mode: 0o700 });
+	const filename = join(directory, "ledger.db");
+	const db = new Database(filename, { create: true });
+	chmodSync(filename, 0o600);
+	db.exec(`
+		CREATE TABLE IF NOT EXISTS routing_sources (key TEXT PRIMARY KEY, entry TEXT NOT NULL);
+		CREATE TABLE IF NOT EXISTS routing_facts (key TEXT PRIMARY KEY, stored TEXT NOT NULL);
+		CREATE TABLE IF NOT EXISTS routing_session_cursors (session_id TEXT PRIMARY KEY, initial_turn INTEGER NOT NULL);
+	`);
+	return db;
+}
+
+export function memoryRoutingFingerprint(context: Pick<MemoryRoutingContext, "cwd">, input: MemoryRoutingInput): string {
+	return createHash("sha256").update(JSON.stringify({
+		kind: input.kind, content: input.content, context: input.context, scopeHint: input.scopeHint,
+		sourceRefs: input.sourceRefs, cwd: context.cwd,
+	})).digest("hex");
+}
+
+export function memoryRoutingSourceKey(context: Pick<MemoryRoutingContext, "cwd">, input: MemoryRoutingInput): string {
+	return createHash("sha256").update(input.sourceId).update("\0").update(memoryRoutingFingerprint(context, input)).digest("hex");
+}
+
+export function memoryRoutingFactKey(decision: MemoryRoutingDecision): string {
+	return createHash("sha256").update(JSON.stringify([
+		decision.scope, decision.projectId ?? null, decision.content.normalize("NFKC").trim().replace(/\s+/g, " "),
+	])).digest("hex");
+}
+
+export function getMemoryRoutingStatus(context: MemoryRoutingContext, input: MemoryRoutingInput): MemoryRoutingLedgerEntry | undefined {
+	const db = openLedger(context.agentDir);
+	try {
+		const row = db.query<{ entry: string }, [string]>("SELECT entry FROM routing_sources WHERE key = ?").get(memoryRoutingSourceKey(context, input));
+		return row ? JSON.parse(row.entry) as MemoryRoutingLedgerEntry : undefined;
+	} finally { db.close(); }
+}
+
+export function listMemoryRoutingLedger(context: Pick<MemoryRoutingContext, "agentDir">): MemoryRoutingLedgerEntry[] {
+	const db = openLedger(context.agentDir);
+	try {
+		return db.query<{ entry: string }, []>("SELECT entry FROM routing_sources ORDER BY key").all().map(row => JSON.parse(row.entry) as MemoryRoutingLedgerEntry);
+	} finally { db.close(); }
+}
+
+export function saveMemoryRoutingStatus(context: MemoryRoutingContext, input: MemoryRoutingInput, entry: Omit<MemoryRoutingLedgerEntry, "key" | "sourceId" | "fingerprint" | "kind" | "sourceRefs" | "updatedAt">): void {
+	const db = openLedger(context.agentDir);
+	try {
+		const key = memoryRoutingSourceKey(context, input);
+		const complete: MemoryRoutingLedgerEntry = {
+			...entry, key, sourceId: redactRoutingSecrets(input.sourceId), fingerprint: memoryRoutingFingerprint(context, input),
+			kind: input.kind, sourceRefs: input.sourceRefs.map(redactRoutingSecrets), updatedAt: new Date().toISOString(),
+		};
+		db.query("INSERT OR REPLACE INTO routing_sources (key, entry) VALUES (?, ?)").run(key, JSON.stringify(complete));
+	} finally { db.close(); }
+}
+
+export function getMemoryRoutingFact(agentDir: string, decision: MemoryRoutingDecision): MemoryRoutingStored | undefined {
+	const db = openLedger(agentDir);
+	try {
+		const row = db.query<{ stored: string }, [string]>("SELECT stored FROM routing_facts WHERE key = ?").get(memoryRoutingFactKey(decision));
+		return row ? JSON.parse(row.stored) as MemoryRoutingStored : undefined;
+	} finally { db.close(); }
+}
+
+export function saveMemoryRoutingFact(agentDir: string, decision: MemoryRoutingDecision, stored: MemoryRoutingStored): void {
+	const db = openLedger(agentDir);
+	try {
+		db.query("INSERT OR REPLACE INTO routing_facts (key, stored) VALUES (?, ?)").run(memoryRoutingFactKey(decision), JSON.stringify(stored));
+	} finally { db.close(); }
+}
+
+/** Actual recall-bank deletion invalidates success and dedup, but not unrelated bank records. */
+function invalidateStored(agentDir: string, bank: string, id?: string): void {
+	if (!existsSync(join(getMemoriesDir(agentDir), "routing", "ledger.db"))) return;
+	const db = openLedger(agentDir);
+	const matches = (stored: MemoryRoutingStored) => stored.bank === bank && (id === undefined || stored.id === id);
+	try {
+		db.transaction(() => {
+			for (const row of db.query<{ key: string; stored: string }, []>("SELECT key, stored FROM routing_facts").all()) {
+				if (matches(JSON.parse(row.stored) as MemoryRoutingStored)) db.query("DELETE FROM routing_facts WHERE key = ?").run(row.key);
+			}
+			for (const row of db.query<{ key: string; entry: string }, []>("SELECT key, entry FROM routing_sources").all()) {
+				const entry = JSON.parse(row.entry) as MemoryRoutingLedgerEntry;
+				if (!entry.stored.some(matches)) continue;
+				entry.stored = entry.stored.filter(stored => !matches(stored));
+				entry.status = "pending";
+				entry.message = "Previously stored memory was deleted or changed; retry requires a fresh commit";
+				entry.updatedAt = new Date().toISOString();
+				db.query("UPDATE routing_sources SET entry = ? WHERE key = ?").run(JSON.stringify(entry), row.key);
+			}
+		})();
+	} finally { db.close(); }
+}
+
+export function invalidateMemoryRoutingBank(agentDir: string, bank: string): void {
+	invalidateStored(agentDir, bank);
+}
+
+export function invalidateMemoryRoutingRecord(agentDir: string, bank: string, id: string): void {
+	invalidateStored(agentDir, bank, id);
+}
+
+function readTranscriptBatchCursor(db: Database, sessionId: string): number | undefined {
+	const prefix = `transcript:${sessionId}:`;
+	let cursor: number | undefined;
+	for (const row of db.query<{ entry: string }, []>("SELECT entry FROM routing_sources").all()) {
+		const entry = JSON.parse(row.entry) as MemoryRoutingLedgerEntry;
+		if (entry.kind !== "transcript" || !entry.sourceId.startsWith(prefix)) continue;
+		const suffix = entry.sourceId.slice(prefix.length);
+		if (!/^\d+$/.test(suffix)) continue;
+		const turn = Number(suffix);
+		if (Number.isSafeInteger(turn)) cursor = Math.max(cursor ?? 0, turn);
+	}
+	return cursor;
+}
+
+/** Pending transcript batches advance admission too; a first-activation baseline prevents importing old history. */
+export function getMemoryRoutingTranscriptCursor(agentDir: string, sessionId: string): number {
+	const db = openLedger(agentDir);
+	try {
+		const baseline = db.query<{ initial_turn: number }, [string]>("SELECT initial_turn FROM routing_session_cursors WHERE session_id = ?").get(sessionId);
+		return Math.max(baseline?.initial_turn ?? 0, readTranscriptBatchCursor(db, sessionId) ?? 0);
+	} finally { db.close(); }
+}
+
+/** Establish the baseline once, including a meaningful zero, without fabricating classification ledger rows. */
+export function ensureMemoryRoutingTranscriptCursor(agentDir: string, sessionId: string, existingUserTurns: number): number {
+	if (!Number.isSafeInteger(existingUserTurns) || existingUserTurns < 0) throw new RangeError("existingUserTurns must be a nonnegative safe integer");
+	const db = openLedger(agentDir);
+	try {
+		return db.transaction(() => {
+			const baseline = db.query<{ initial_turn: number }, [string]>("SELECT initial_turn FROM routing_session_cursors WHERE session_id = ?").get(sessionId);
+			const recorded = readTranscriptBatchCursor(db, sessionId);
+			if (baseline) return Math.max(baseline.initial_turn, recorded ?? 0);
+			// Existing batches already define admission: do not advance over their unprocessed tail on restart.
+			const initial = recorded ?? existingUserTurns;
+			db.query("INSERT INTO routing_session_cursors (session_id, initial_turn) VALUES (?, ?)").run(sessionId, initial);
+			return initial;
+		}).immediate();
+	} finally { db.close(); }
+}
diff --git a/src/memory-routing/migration.ts b/src/memory-routing/migration.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8d224a0dbe75089095b254af38520c33022684ee
--- /dev/null
+++ b/src/memory-routing/migration.ts
@@ -0,0 +1,506 @@
+import { createHash } from "node:crypto";
+import { existsSync, lstatSync, mkdirSync, readdirSync, readFileSync, realpathSync, writeFileSync } from "node:fs";
+import { dirname, isAbsolute, join, relative, resolve, sep } from "node:path";
+import { Database } from "bun:sqlite";
+import type { Mnemopi } from "@oh-my-pi/pi-mnemopi";
+import { currentEmbeddingModel } from "@oh-my-pi/pi-mnemopi/core/embeddings";
+import { type EmbedItem, scheduleEmbedding } from "@oh-my-pi/pi-mnemopi/core/beam/helpers";
+import { withMnemopiRuntimeOptions } from "@oh-my-pi/pi-mnemopi/core/runtime-options";
+import { getMemoriesDir } from "@oh-my-pi/pi-utils";
+import { all } from "../config/registry";
+import { MEMORY_ROUTING_POLICY_FINGERPRINT } from "./classifier";
+import { redactRoutingSecrets as redactMemorySecrets } from "./redact";
+import { loadMnemopiConfig } from "../mnemopi/config";
+import { loadMnemopi, loadMnemopiCore } from "../mnemopi/state";
+import { memoryRoutingLedgerAgentDir } from "./ledger";
+import { routingProjectBank } from "./projects";
+import { classifyMemoryWrite, commitMemoryDecisions } from "./service";
+import type { MemoryRoutingContext, MemoryRoutingDecision, MemoryRoutingInput, MemoryRoutingOutcome } from "./types";
+
+export interface LegacyMemoryRow {
+	thread_id: string;
+	source_updated_at: number;
+	raw_memory: string;
+	rollout_summary: string;
+	rollout_slug: string | null;
+	generated_at: number;
+	cwd: string | null;
+}
+export interface MigrationFile {
+	path: string;
+	fingerprint: string;
+	kind: "learned" | "derived" | "skill";
+}
+export interface MigrationSource {
+	kind: "stage1" | "learned";
+	fingerprint: string;
+	cwd?: string;
+	input: MemoryRoutingInput;
+}
+export interface MemoryMigrationCorpus {
+	sourceDb: string;
+	memoryRoot: string;
+	rows: LegacyMemoryRow[];
+	sources: MigrationSource[];
+	files: MigrationFile[];
+}
+export interface MigrationDestination {
+	bank: string;
+	dbPath: string;
+}
+export interface MemoryMigrationEntry extends MigrationSource {
+	/** Hashes source identity/content, final input/context, settings/model evidence and exact destination. */
+	classificationFingerprint: string;
+	policyFingerprint: string;
+	decisions: MemoryRoutingDecision[];
+	destinations: Array<MigrationDestination | null>;
+	status: "reviewed" | "pending" | "skipped";
+}
+export interface MemoryMigrationManifest {
+	version: 1;
+	createdAt: string;
+	sourceDb: string;
+	memoryRoot: string;
+	targetDb: string;
+	baseBank: string;
+	globalBank: string;
+	configuration: string;
+	files: MigrationFile[];
+	skills: MigrationFile[];
+	entries: MemoryMigrationEntry[];
+	counts: { stage1: number; learned: number; files: number; skills: number; store: number; skip: number; pending: number };
+}
+
+export function memoryMigrationFingerprint(value: string): string {
+	return createHash("sha256").update(value).digest("hex");
+}
+
+/** Deliberately allowlist configuration fields; never serialize settings or credential stores. */
+export function migrationConfigurationSnapshot(input: {
+	modelRoles: Readonly<Record<string, string>>;
+	projects: unknown;
+	launcher?: string;
+	configFiles?: string[];
+}): string {
+	return redactMemorySecrets(JSON.stringify({
+		modelRoles: input.modelRoles,
+		projects: input.projects,
+		launcher: input.launcher,
+		configFiles: input.configFiles,
+		note: "Current configuration is authoritative; stale remembered configuration must not override it.",
+	}));
+}
+
+function projectDirectoryName(cwd: string): string {
+	return `--${cwd.replace(/^[/\\]/, "").replace(/[/\\:]/g, "-")}--`;
+}
+
+/** Read every stage-1 output, including outputs that never produced a derived file. No rollout files are opened. */
+export function readMemoryMigrationCorpus(options: {
+	sourceDb: string;
+	memoryRoot: string;
+	projectRoots?: string[];
+}): MemoryMigrationCorpus {
+	const sourceDb = resolve(options.sourceDb);
+	const memoryRoot = resolve(options.memoryRoot);
+	const db = new Database(sourceDb, { readonly: true, strict: true });
+	let rows: LegacyMemoryRow[];
+	let cwds: string[];
+	try {
+		rows = db.query<LegacyMemoryRow, []>(`
+			SELECT o.thread_id, o.source_updated_at, o.raw_memory, o.rollout_summary,
+			       o.rollout_slug, o.generated_at, t.cwd
+			FROM stage1_outputs o LEFT JOIN threads t ON t.id = o.thread_id
+			WHERE trim(o.raw_memory) != '' OR trim(o.rollout_summary) != ''
+			ORDER BY o.thread_id
+		`).all();
+		cwds = db.query<{ cwd: string }, []>("SELECT DISTINCT cwd FROM threads WHERE cwd != ''").all().map(row => row.cwd);
+	} finally {
+		db.close();
+	}
+	const roots = [...new Set([...cwds, ...(options.projectRoots ?? [])])];
+	const files: MigrationFile[] = [];
+	const sources: MigrationSource[] = rows.map(row => {
+		const raw = JSON.stringify(row);
+		const ref = `${sourceDb}#stage1_outputs/${encodeURIComponent(row.thread_id)}`;
+		return {
+			kind: "stage1", fingerprint: memoryMigrationFingerprint(raw), cwd: row.cwd ?? undefined,
+			input: {
+				sourceId: `migration:stage1:${memoryMigrationFingerprint(`${sourceDb}:${row.thread_id}`)}`,
+				kind: "migration", sourceRefs: [ref],
+				content: redactMemorySecrets([row.raw_memory.trim(), row.rollout_summary.trim()].filter(Boolean).join("\n\nRollout summary (same source; do not duplicate facts):\n")),
+				context: redactMemorySecrets(JSON.stringify({ originalThreadId: row.thread_id, originalCwd: row.cwd, sourceUpdatedAt: row.source_updated_at, generatedAt: row.generated_at })),
+			},
+		};
+	});
+	const visit = (directory: string): void => {
+		for (const entry of readdirSync(directory, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
+			const path = join(directory, entry.name);
+			if (entry.isSymbolicLink()) continue;
+			if (entry.isDirectory()) {
+				// Routing journals and Mnemopi banks are not legacy local-memory inputs.
+				if (entry.name !== "routing" && entry.name !== "mnemopi" && entry.name !== ".routing-agent") visit(path);
+				continue;
+			}
+			if (!entry.isFile()) continue;
+			const rel = relative(memoryRoot, path).split(sep);
+			const kind = rel.includes("skills") ? "skill"
+				: entry.name === "learned.md" ? "learned"
+				: ["MEMORY.md", "memory_summary.md", "raw_memories.md"].includes(entry.name) || rel.includes("rollout_summaries") ? "derived" : undefined;
+			if (!kind) continue;
+			const text = readFileSync(path, "utf8");
+			files.push({ path, fingerprint: memoryMigrationFingerprint(text), kind });
+			if (kind !== "learned") continue;
+			const originalCwd = roots.find(cwd => rel[0] === projectDirectoryName(cwd));
+			const lines = text.split(/\r?\n/);
+			// Native learned.md stores one lesson per bullet. Keep manual prose as a separate source too.
+			let prose: string[] = [];
+			let proseLine = 1;
+			const add = (content: string, line: number): void => {
+				if (!content.trim()) return;
+				const sourceRef = `${path}#L${line}`;
+				sources.push({ kind: "learned", fingerprint: memoryMigrationFingerprint(content), cwd: originalCwd,
+					input: { sourceId: `migration:learned:${memoryMigrationFingerprint(`${path}:${content.trim()}`)}`, kind: "migration",
+						content: redactMemorySecrets(content), sourceRefs: [sourceRef],
+						context: redactMemorySecrets(JSON.stringify({ originalCwd: originalCwd ?? null, learnedFile: path })) } });
+			};
+			for (const [index, line] of lines.entries()) {
+				if (/^\s*-\s+/.test(line)) {
+					add(prose.join("\n"), proseLine); prose = [];
+					add(line.replace(/^\s*-\s+/, ""), index + 1);
+				} else if (line.trim() && !/^\s*#/.test(line)) {
+					if (prose.length === 0) proseLine = index + 1;
+					prose.push(line);
+				}
+			}
+			add(prose.join("\n"), proseLine);
+		}
+	};
+	if (existsSync(memoryRoot)) visit(memoryRoot);
+	return { sourceDb, memoryRoot, rows, sources, files };
+}
+
+/** Checks both lexical traversal and existing symlink ancestors, including a not-yet-created target. */
+export function assertMigrationPathInside(root: string, target: string): void {
+	const absoluteRoot = resolve(root);
+	const absoluteTarget = resolve(target);
+	const check = (base: string, path: string): void => {
+		const rel = relative(base, path);
+		if (!rel || rel === ".." || rel.startsWith(`..${sep}`) || isAbsolute(rel)) throw new Error("Migration target must be a file inside its selected root");
+	};
+	check(absoluteRoot, absoluteTarget);
+	const canonical = (path: string): string => {
+		if (existsSync(path)) return realpathSync(path);
+		const parent = dirname(path);
+		if (parent === path) return path;
+		return join(canonical(parent), relative(parent, path));
+	};
+	check(canonical(absoluteRoot), canonical(absoluteTarget));
+}
+
+export function migrationDestination(decision: MemoryRoutingDecision, targetDb: string, baseBank: string, globalBank: string): MigrationDestination | null {
+	if (decision.action !== "store") return null;
+	if (decision.scope === "global") return { bank: globalBank, dbPath: resolve(targetDb) };
+	if (decision.scope !== "project" || !decision.projectId) throw new Error("Stored migration decision has no valid destination");
+	const bank = routingProjectBank(baseBank, decision.projectId);
+	if (!/^[a-zA-Z0-9_-]+$/.test(bank)) throw new Error("Invalid migration project bank");
+	return { bank, dbPath: join(dirname(resolve(targetDb)), "banks", bank, "mnemopi.db") };
+}
+
+export function selectMemoryMigrationSources(corpus: MemoryMigrationCorpus, options: { limit?: number; sources?: string[] }): MemoryMigrationCorpus {
+	if (options.limit !== undefined && (!Number.isSafeInteger(options.limit) || options.limit < 1)) throw new Error("--limit must be a positive integer");
+	const selected = options.sources?.length
+		? corpus.sources.filter(source => options.sources!.some(query => source.input.sourceId.includes(query) || source.input.sourceRefs.some(ref => ref.includes(query))))
+		: corpus.sources;
+	return { ...corpus, sources: options.limit === undefined ? selected : selected.slice(0, options.limit) };
+}
+
+/** Only newline-terminated records are complete checkpoints; an interrupted final append is not reusable. */
+export function readMemoryMigrationCheckpoint(path: string): MemoryMigrationEntry[] {
+	if (!existsSync(path)) return [];
+	const text = readFileSync(path, "utf8");
+	const completed = text.slice(0, text.lastIndexOf("\n") + 1);
+	return completed.split("\n").filter(line => line.trim()).map(line => {
+		const entry = JSON.parse(line) as MemoryMigrationEntry;
+		if (!entry.input || typeof entry.input.sourceId !== "string" || typeof entry.fingerprint !== "string"
+			|| typeof entry.classificationFingerprint !== "string" || !Array.isArray(entry.decisions)
+			|| !Array.isArray(entry.destinations)) throw new Error("Malformed migration checkpoint entry");
+		return entry;
+	});
+}
+
+export async function previewMemoryMigration(options: {
+	context: MemoryRoutingContext;
+	corpus: MemoryMigrationCorpus;
+	targetDb: string;
+	baseBank?: string;
+	globalBank?: string;
+	configuration?: string;
+	concurrency?: number;
+	resumeEntries?: MemoryMigrationEntry[];
+	retryPending?: boolean;
+	onEntry?: (entry: MemoryMigrationEntry, index: number) => void | Promise<void>;
+	classify?: typeof classifyMemoryWrite;
+}): Promise<MemoryMigrationManifest> {
+	const concurrency = options.concurrency ?? 2;
+	if (!Number.isInteger(concurrency) || concurrency < 1 || concurrency > 4) throw new Error("Migration preview concurrency must be an integer from 1 to 4");
+	const targetDb = resolve(options.targetDb);
+	if (targetDb === resolve(options.corpus.sourceDb) || (existsSync(dirname(targetDb)) && readdirSync(dirname(targetDb)).length !== 0)) {
+		throw new Error("Preview requires a new empty dedicated target directory");
+	}
+	const baseBank = options.baseBank ?? "default";
+	const globalBank = options.globalBank ?? baseBank;
+	const entries = new Array<MemoryMigrationEntry>(options.corpus.sources.length);
+	const counts = { stage1: options.corpus.sources.filter(source => source.kind === "stage1").length, learned: 0, files: options.corpus.files.length,
+		skills: options.corpus.files.filter(file => file.kind === "skill").length, store: 0, skip: 0, pending: 0 };
+	const settingsFingerprint = memoryMigrationFingerprint(redactMemorySecrets(JSON.stringify(
+		all().filter(setting => !setting.isCredential).map(setting => [setting.id, setting.get(options.context.settings)]),
+	)));
+	const modelFingerprint = memoryMigrationFingerprint(JSON.stringify(options.classify ? [] : options.context.modelRegistry.getAll().map(model => ({
+		provider: model.provider, id: model.id, api: model.api, baseUrl: model.baseUrl,
+		reasoning: model.reasoning, thinking: model.thinking, contextWindow: model.contextWindow, maxTokens: model.maxTokens,
+	}))));
+	const resumeEntries = new Map((options.resumeEntries ?? []).map(entry => [entry.classificationFingerprint, entry]));
+	let nextSource = 0;
+	const classifyNext = async (): Promise<void> => {
+		while (nextSource < options.corpus.sources.length) {
+			const index = nextSource++;
+			const source = options.corpus.sources[index]!;
+			const input = { ...source.input, context: [source.input.context, options.configuration].filter(Boolean).join("\n") };
+			const classificationFingerprint = memoryMigrationFingerprint(JSON.stringify({
+				policyFingerprint: MEMORY_ROUTING_POLICY_FINGERPRINT,
+				source: { kind: source.kind, fingerprint: source.fingerprint, cwd: source.cwd ?? options.context.cwd },
+				input, configuration: options.configuration ?? "", settingsFingerprint, modelFingerprint,
+				targetDb, baseBank, globalBank,
+			}));
+			const cached = resumeEntries.get(classificationFingerprint);
+			const reusable = cached && cached.fingerprint === source.fingerprint
+				&& cached.policyFingerprint === MEMORY_ROUTING_POLICY_FINGERPRINT
+				&& JSON.stringify(cached.input) === JSON.stringify(input)
+				&& cached.decisions.length === cached.destinations.length
+				&& cached.decisions.every((decision, decisionIndex) => JSON.stringify(
+					migrationDestination(decision, targetDb, baseBank, globalBank),
+				) === JSON.stringify(cached.destinations[decisionIndex]))
+				&& !(options.retryPending && cached.decisions.some(decision => decision.action === "pending"));
+			if (reusable) {
+				entries[index] = cached;
+			} else {
+				const decisions = await (options.classify ?? classifyMemoryWrite)({ ...options.context, cwd: source.cwd ?? options.context.cwd }, input);
+				const destinations = decisions.map(decision => migrationDestination(decision, targetDb, baseBank, globalBank));
+				for (const target of destinations) if (target) assertMigrationPathInside(dirname(targetDb), target.dbPath);
+				const entry: MemoryMigrationEntry = { ...source, input, decisions, destinations, classificationFingerprint,
+					policyFingerprint: MEMORY_ROUTING_POLICY_FINGERPRINT,
+					status: decisions.some(decision => decision.action === "pending") ? "pending"
+						: decisions.some(decision => decision.action === "store") ? "reviewed" : "skipped" };
+				entries[index] = entry;
+				await options.onEntry?.(entry, index);
+			}
+			for (const decision of entries[index]!.decisions) counts[decision.action]++;
+			if (source.kind === "learned") counts.learned++;
+		}
+	};
+	await Promise.all(Array.from({ length: Math.min(concurrency, options.corpus.sources.length) }, () => classifyNext()));
+	return { version: 1, createdAt: new Date().toISOString(), sourceDb: options.corpus.sourceDb,
+		memoryRoot: options.corpus.memoryRoot, targetDb, baseBank, globalBank,
+		configuration: options.configuration ?? "", files: options.corpus.files,
+		skills: options.corpus.files.filter(file => file.kind === "skill"), entries, counts };
+}
+
+/** Backup only the two memory tables and inventoried memory files, never agent.db or raw sessions. */
+export function backupMemoryMigrationCorpus(corpus: MemoryMigrationCorpus, outputDirectory: string): void {
+	const output = resolve(outputDirectory);
+	if (existsSync(output) && readdirSync(output).length > 0) throw new Error("Memory backup directory must be empty");
+	mkdirSync(output, { recursive: true, mode: 0o700 });
+	// The joined rows contain precisely the memory fields needed to recover provenance, not auth/settings tables.
+	writeFileSync(join(output, "stage1-memory-rows.json"), `${JSON.stringify(corpus.rows, null, 2)}\n`, { mode: 0o600, flag: "wx" });
+	const files = join(output, "files");
+	for (const file of corpus.files) {
+		const target = join(files, relative(corpus.memoryRoot, file.path));
+		assertMigrationPathInside(output, target);
+		mkdirSync(dirname(target), { recursive: true, mode: 0o700 });
+		writeFileSync(target, readFileSync(file.path), { mode: 0o600, flag: "wx" });
+	}
+}
+
+export function readMemoryMigrationManifest(path: string): MemoryMigrationManifest {
+	const manifest = JSON.parse(readFileSync(path, "utf8")) as MemoryMigrationManifest;
+	if (manifest.version !== 1 || !Array.isArray(manifest.entries) || !Array.isArray(manifest.files)
+		|| typeof manifest.targetDb !== "string" || typeof manifest.baseBank !== "string" || typeof manifest.globalBank !== "string") {
+		throw new Error("Unsupported or malformed memory migration manifest");
+	}
+	for (const entry of manifest.entries) {
+		if (!entry.input || entry.input.kind !== "migration" || typeof entry.input.sourceId !== "string"
+			|| typeof entry.input.content !== "string" || !Array.isArray(entry.input.sourceRefs)
+			|| !Array.isArray(entry.decisions) || !Array.isArray(entry.destinations)
+			|| entry.decisions.length !== entry.destinations.length) throw new Error("Malformed memory migration entry");
+		for (const [index, decision] of entry.decisions.entries()) {
+			if (!["store", "skip", "pending"].includes(decision.action) || typeof decision.content !== "string"
+				|| typeof decision.reason !== "string" || !Array.isArray(decision.sourceRefs)) throw new Error("Malformed migration decision");
+			const expected = migrationDestination(decision, manifest.targetDb, manifest.baseBank, manifest.globalBank);
+			if (JSON.stringify(expected) !== JSON.stringify(entry.destinations[index])) throw new Error("Manifest destination does not match reviewed decision");
+		}
+	}
+	return manifest;
+}
+
+interface MigrationReceipt {
+	version: 1;
+	manifest: string;
+	targetDb: string;
+	outcomes: MemoryRoutingOutcome[];
+}
+
+export function memoryMigrationStatus(manifest: MemoryMigrationManifest): {
+	counts: MemoryMigrationManifest["counts"];
+	applied: boolean;
+	outcomes: MemoryRoutingOutcome[];
+} {
+	const path = join(dirname(resolve(manifest.targetDb)), ".memory-routing-migration.json");
+	if (!existsSync(path)) return { counts: manifest.counts, applied: false, outcomes: [] };
+	const receipt = JSON.parse(readFileSync(path, "utf8")) as MigrationReceipt;
+	const matches = receipt.manifest === memoryMigrationFingerprint(JSON.stringify(manifest));
+	return { counts: manifest.counts, applied: matches && receipt.outcomes.length === manifest.entries.length && receipt.outcomes.every(outcome => !outcome.pending),
+		outcomes: matches ? receipt.outcomes : [] };
+}
+
+function migrationContentKey(content: string): string {
+	return memoryMigrationFingerprint(content.normalize("NFKC").trim().replace(/\s+/g, " "));
+}
+
+/** Aggregate before committing: shared admission may deduplicate a later source without invoking the writer. */
+export function collectMigrationProvenance(manifest: MemoryMigrationManifest): Map<string, string[]> {
+	const refs = new Map<string, Set<string>>();
+	for (const entry of manifest.entries) {
+		for (const decision of entry.decisions) {
+			const destination = migrationDestination(decision, manifest.targetDb, manifest.baseBank, manifest.globalBank);
+			if (!destination) continue;
+			const key = `${destination.bank}:${migrationContentKey(decision.content)}`;
+			const merged = refs.get(key) ?? new Set<string>();
+			for (const ref of [...entry.input.sourceRefs, ...decision.sourceRefs]) merged.add(ref);
+			refs.set(key, merged);
+		}
+	}
+	return new Map([...refs].map(([key, values]) => [key, [...values]]));
+}
+
+/** Applies the manifest verbatim. The classifier is intentionally absent from this path. */
+export async function applyMemoryMigration(options: {
+	context: MemoryRoutingContext;
+	manifest: MemoryMigrationManifest;
+	targetDb?: string;
+}): Promise<MemoryRoutingOutcome[]> {
+	const { manifest } = options;
+	const targetDb = resolve(options.targetDb ?? manifest.targetDb);
+	if (targetDb !== resolve(manifest.targetDb)) throw new Error("--db must match the reviewed preview target; create a new preview to change targets");
+	if (targetDb === resolve(manifest.sourceDb)) throw new Error("Migration cannot write into source agent.db");
+	const root = dirname(targetDb);
+	const marker = join(root, ".memory-routing-migration.json");
+	const digest = memoryMigrationFingerprint(JSON.stringify(manifest));
+	const destinations = manifest.entries.flatMap(entry => entry.decisions.flatMap((decision, index) => {
+		const expected = migrationDestination(decision, targetDb, manifest.baseBank, manifest.globalBank);
+		if (JSON.stringify(expected) !== JSON.stringify(entry.destinations[index])) throw new Error("Manifest destination changed since preview");
+		return expected ? [expected] : [];
+	}));
+	for (const destination of [{ bank: manifest.globalBank, dbPath: targetDb }, ...destinations]) {
+		assertMigrationPathInside(root, destination.dbPath);
+		if (destination.bank === "" || /[/\\.]/.test(destination.bank)) throw new Error("Invalid migration bank name");
+	}
+	let receipt: MigrationReceipt;
+	if (existsSync(marker)) {
+		if (lstatSync(marker).isSymbolicLink()) throw new Error("Migration receipt cannot be a symlink");
+		receipt = JSON.parse(readFileSync(marker, "utf8")) as MigrationReceipt;
+		if (receipt.manifest !== digest || receipt.targetDb !== targetDb) throw new Error("Target root belongs to another migration");
+	} else {
+		// A dedicated fresh root prevents accidentally writing into an existing project bank.
+		if (existsSync(root) && readdirSync(root).length !== 0) throw new Error("Migration requires a new empty target directory");
+		mkdirSync(root, { recursive: true, mode: 0o700 });
+		receipt = { version: 1, manifest: digest, targetDb, outcomes: [] };
+		writeFileSync(marker, `${JSON.stringify(receipt, null, 2)}\n`, { mode: 0o600, flag: "wx" });
+	}
+	const [{ Mnemopi }, { BankManager }] = await Promise.all([loadMnemopi(), loadMnemopiCore()]);
+	const config = loadMnemopiConfig(options.context.settings, options.context.agentDir);
+	const banks = new BankManager(root);
+	const handles = new Map<string, Mnemopi>();
+	const outcomes: MemoryRoutingOutcome[] = [];
+	const provenance = collectMigrationProvenance(manifest);
+	try {
+		for (const entry of manifest.entries) {
+			const outcome = await commitMemoryDecisions({ ...options.context, agentDir: memoryRoutingLedgerAgentDir(targetDb), cwd: entry.cwd ?? options.context.cwd }, entry.input, entry.decisions, async decision => {
+				const destination = migrationDestination(decision, targetDb, manifest.baseBank, manifest.globalBank);
+				if (!destination || !decision.scope) throw new Error("Cannot commit a non-store decision");
+				const dbPath = decision.scope === "global" ? targetDb : banks.getBankDbPath(destination.bank);
+				if (dbPath !== destination.dbPath) throw new Error("Mnemopi bank path differs from reviewed target");
+				assertMigrationPathInside(root, dbPath);
+				let memory = handles.get(destination.bank);
+				if (!memory) {
+					mkdirSync(dirname(dbPath), { recursive: true, mode: 0o700 });
+					memory = new Mnemopi({ ...config.providerOptions, dbPath, bank: destination.bank, sessionId: destination.bank,
+						authorId: "coding-agent", channelId: destination.bank, llm: false, proactiveLinking: false,
+						noEmbeddings: true, reconcile: false });
+					handles.set(destination.bank, memory);
+				}
+				const key = migrationContentKey(decision.content);
+				const previous = memory.db.query<{ id: string }, [string, string]>(`
+					SELECT id FROM working_memory WHERE json_extract(metadata_json, '$.migration_content_hash') = ?
+					UNION ALL
+					SELECT id FROM episodic_memory WHERE json_extract(metadata_json, '$.migration_content_hash') = ?
+					LIMIT 1
+				`).get(key, key);
+				const id = previous?.id ?? memory.remember(decision.content, { source: "coding-agent-migration", scope: "bank",
+					memoryType: "fact", importance: 0.8, trustTier: "IMPORTED", veracity: "imported", extract: false, extractEntities: false,
+					metadata: { migration_batch: digest, migration_content_hash: key, migration_source_id: entry.input.sourceId,
+						source_refs: provenance.get(`${destination.bank}:${key}`) ?? [...new Set([...entry.input.sourceRefs, ...decision.sourceRefs])], original_cwd: entry.cwd ?? null,
+						source_fingerprint: entry.fingerprint, routing_reason: decision.reason } });
+				return { id, bank: destination.bank, scope: decision.scope, ...(decision.projectId ? { projectId: decision.projectId } : {}) };
+			});
+			outcomes.push(outcome);
+			receipt.outcomes = outcomes;
+			writeFileSync(marker, `${JSON.stringify(receipt, null, 2)}\n`, { mode: 0o600 });
+		}
+	} finally {
+		for (const memory of handles.values()) {
+			try { await memory.flushExtractions(); } finally { memory.close(); }
+		}
+	}
+	// Text admission is durable before indexing. Opening a writer must never enqueue
+	// hundreds of competing embeddings or an automatic model reconciliation.
+	if (!config.providerOptions.noEmbeddings) {
+		for (const destination of new Map(destinations.map(target => [target.dbPath, target])).values()) {
+			if (!existsSync(destination.dbPath)) continue;
+			assertMigrationPathInside(root, destination.dbPath);
+			const memory = new Mnemopi({ ...config.providerOptions, dbPath: destination.dbPath, bank: destination.bank,
+				sessionId: destination.bank, authorId: "coding-agent", channelId: destination.bank,
+				llm: false, proactiveLinking: false, reconcile: false });
+			try {
+				const activeModel = withMnemopiRuntimeOptions(memory.runtimeOptions, () => currentEmbeddingModel().trim());
+				if (!activeModel) throw new Error("No active embedding model");
+				const missing = memory.db.query<EmbedItem, [string, string]>(`
+					SELECT id AS memoryId, COALESCE(embed_text, content) AS content FROM working_memory
+					WHERE superseded_by IS NULL AND id NOT IN (SELECT memory_id FROM memory_embeddings WHERE model = ?)
+					UNION ALL
+					SELECT id AS memoryId, content FROM episodic_memory
+					WHERE superseded_by IS NULL AND id NOT IN (SELECT memory_id FROM memory_embeddings WHERE model = ?)
+				`).all(activeModel, activeModel);
+				for (let offset = 0; offset < missing.length; offset += 8) {
+					const batch = missing.slice(offset, offset + 8);
+					withMnemopiRuntimeOptions(memory.runtimeOptions, () => scheduleEmbedding(memory.beam, batch));
+					await memory.flushExtractions();
+					for (const item of batch) {
+						if (!memory.db.query<{ present: number }, [string, string]>(
+							"SELECT 1 AS present FROM memory_embeddings WHERE memory_id = ? AND model = ? LIMIT 1",
+						).get(item.memoryId, activeModel)) throw new Error("An active-model vector was not persisted");
+					}
+				}
+			} catch {
+				throw new Error(`Memory migration embedding index failed for bank ${destination.bank}; text and receipt are preserved. Rerun apply to repair missing vectors.`);
+			} finally {
+				memory.close();
+			}
+		}
+	}
+	return outcomes;
+}
+
+export function migrationLedgerDirectory(targetDb: string): string {
+	return join(getMemoriesDir(memoryRoutingLedgerAgentDir(targetDb)), "routing");
+}
