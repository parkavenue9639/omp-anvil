@@ -0,0 +1,370 @@
+import { Database } from "bun:sqlite";
+import { createHash } from "node:crypto";
+import { existsSync } from "node:fs";
+import { basename, dirname, join, resolve } from "node:path";
+import type { BeamMemoryState } from "@oh-my-pi/pi-mnemopi/core/beam/types";
+import * as nativeConfig from "@oh-my-pi/pi-mnemopi/config";
+import type { ResolvedMnemopiRuntimeOptions } from "@oh-my-pi/pi-mnemopi/core/runtime-options";
+import { getMemoriesDir } from "@oh-my-pi/pi-utils";
+import type { Settings } from "../config/settings";
+import { redactRoutingSecrets } from "../memory-routing/redact";
+import type { MemoryBackendSearchItem, MemoryBackendSearchResult } from "../memory-backend/types";
+import { listRegisteredRoutingProjects, routingProjectBank } from "../memory-routing/projects";
+import { cfgMemoryRoutingCrossProjectRead, cfgMemoryRoutingEnabled } from "../memory-routing/settings";
+import type { MemoryRoutingProject } from "../memory-routing/types";
+import { loadMnemopiCore, type MnemopiSessionState } from "./state";
+import { computeMnemopiBankScope } from "./config";
+import { cfgMemoryBackend } from "../memory-backend/settings";
+import {
+	cfgMnemopiBank, cfgMnemopiDbPath, cfgMnemopiScoping, cfgMnemopiNoEmbeddings,
+	cfgMnemopiEmbeddingModel, cfgMnemopiEmbeddingVariant, cfgMnemopiEmbeddingApiUrl, cfgMnemopiEmbeddingApiKey,
+	cfgMnemopiDebug, cfgMnemopiPolyphonicRecall, cfgMnemopiEnhancedRecall,
+} from "./settings";
+
+const WINDOW = 100;
+const PAGE_BUDGET = 16_000;
+// Continuations survive restarts; every request independently validates targets.
+type Row = Record<string, unknown>;
+
+export interface ProjectMemoryRecord {
+	id: string;
+	projectId: string;
+	projectName: string;
+	bank: string;
+	store: "working" | "episodic" | "fact";
+	content: string;
+	source?: string;
+	timestamp?: string;
+	createdAt?: string;
+	veracity?: string;
+	evidenceStatus?: string;
+	sourceRefs: string[];
+	retired: boolean;
+}
+
+export interface ProjectMemoryRecallRequest {
+	query: string;
+	projectIds: readonly string[];
+	limit?: number;
+	cursor?: string;
+	signal?: AbortSignal;
+}
+
+export interface ProjectMemoryStandaloneReadOptions {
+	/** Pure text/fact ranking; never derive a query embedding or invoke a model. */
+	noInference?: boolean;
+}
+
+interface Target { project: MemoryRoutingProject; bank: string; path: string }
+interface Continuation { binding: string; offset: number; time: string; window?: string }
+
+function ownerState(state: MnemopiSessionState): MnemopiSessionState {
+	while (state.aliasOf) state = state.aliasOf;
+	return state;
+}
+
+interface ReadCaller {
+	settings: Settings;
+	dbPath: string;
+	baseBank?: string;
+	scoping?: string;
+	beam: Pick<BeamMemoryState, "authorId" | "authorType" | "useCloud" | "config">;
+	runtimeOptions?: ResolvedMnemopiRuntimeOptions;
+}
+
+function sessionCaller(state: MnemopiSessionState): ReadCaller {
+	const primary = ownerState(state);
+	if (!primary.memory?.beam) throw new Error("Cross-project reads require an initialized project-scoped Mnemopi session.");
+	return { settings: primary.session.settings, ...primary.config, beam: primary.memory.beam, runtimeOptions: primary.memory.runtimeOptions };
+}
+
+function targets(settings: Settings, caller: ReadCaller, ids: readonly string[]): Target[] {
+	const ownerSettings = caller.settings;
+	if (resolve(settings.getAgentDir()) !== resolve(ownerSettings.getAgentDir())) {
+		throw new Error("Project memory reads cannot mix caller and owner profiles.");
+	}
+	if (!cfgMemoryRoutingEnabled.get(settings) || !cfgMemoryRoutingCrossProjectRead.get(settings)
+		|| !cfgMemoryRoutingEnabled.get(ownerSettings) || !cfgMemoryRoutingCrossProjectRead.get(ownerSettings)) {
+		throw new Error("Cross-project memory reads are disabled.");
+	}
+	if (!["per-project", "per-project-tagged"].includes(caller.scoping ?? "per-project")) {
+		throw new Error("Cross-project reads require project-scoped Mnemopi.");
+	}
+	if (!Array.isArray(ids) || ids.length < 1 || ids.length > 2 || new Set(ids).size !== ids.length
+		|| ids.some(id => typeof id !== "string" || !id.trim() || id !== id.trim() || id === "*")) {
+		throw new Error("projectIds must contain one or two distinct exact registered project IDs.");
+	}
+	const catalog = listRegisteredRoutingProjects(ownerSettings);
+	return [...ids].sort().map(id => {
+		const project = catalog.find(entry => entry.id === id);
+		if (!project) throw new Error(`Unknown memory project: ${JSON.stringify(id)}`);
+		const bank = routingProjectBank(caller.baseBank, id);
+		// Compute the pinned BankManager layout without constructing or initializing a bank.
+		return { project, bank, path: join(dirname(caller.dbPath), "banks", bank, "mnemopi.db") };
+	});
+}
+
+function digest(value: unknown): string {
+	return createHash("sha256").update(JSON.stringify(value)).digest("base64url");
+}
+
+function encodeCursor(value: Continuation): string {
+	const body = Buffer.from(JSON.stringify(value)).toString("base64url");
+	return `${body}.${digest(body)}`;
+}
+
+function decodeCursor(cursor: string | undefined, binding: string): Continuation {
+	if (cursor === undefined) return { binding, offset: 0, time: new Date().toISOString() };
+	if (typeof cursor !== "string" || cursor.length > 1500 || !/^[\w-]+\.[\w-]+$/.test(cursor)) {
+		throw new Error("Invalid project memory cursor.");
+	}
+	const [body, checksum] = cursor.split(".") as [string, string];
+	if (checksum !== digest(body)) throw new Error("Invalid project memory cursor.");
+	let value: Continuation;
+	try { value = JSON.parse(Buffer.from(body, "base64url").toString("utf8")); }
+	catch { throw new Error("Invalid project memory cursor."); }
+	if (!value || value.binding !== binding || !Number.isInteger(value.offset) || value.offset < 1 || value.offset >= WINDOW
+		|| typeof value.time !== "string" || !Number.isFinite(Date.parse(value.time)) || typeof value.window !== "string") {
+		throw new Error("Project memory cursor does not match this query and target set.");
+	}
+	return value;
+}
+
+// Native recall tolerates absent tables in several fallback paths. A foreign
+// incompatible database must be an explicit error, never an apparent empty bank.
+function validateSchema(db: Database): void {
+	const memory = "id,content,source,timestamp,session_id,importance,metadata_json,veracity,memory_type,recall_count,last_recalled,valid_until,superseded_by,scope,author_id,author_type,channel_id,event_date,event_date_precision,temporal_tags,created_at";
+	try {
+		db.query(`SELECT ${memory},embed_text FROM working_memory LIMIT 0`).all();
+		db.query(`SELECT ${memory},rowid,summary_of,tier FROM episodic_memory LIMIT 0`).all();
+		db.query("SELECT fact_id,subject,predicate,object,timestamp,confidence,session_id,source_msg_id,created_at FROM facts LIMIT 0").all();
+		db.query("SELECT memory_id,embedding_json FROM memory_embeddings LIMIT 0").all();
+	} catch (error) {
+		throw new Error(`Incompatible or corrupt project memory schema: ${error instanceof Error ? error.message : String(error)}`);
+	}
+}
+
+function readonlyBeam(db: Database, target: Target, owner: ReadCaller): BeamMemoryState {
+	const caller = owner.beam;
+	return {
+		db, dbPath: target.path, sessionId: target.bank, channelId: target.bank,
+		authorId: caller.authorId, authorType: caller.authorType, useCloud: caller.useCloud,
+		config: caller.config,
+		caches: { timestampParse: new Map(), extractionBuffer: [] },
+		pluginManager: null, annotations: null, triples: null, episodicGraph: null, veracityConsolidator: null,
+	};
+}
+
+function metadata(row: Row): Row {
+	const raw = row.metadata ?? row.metadata_json;
+	if (typeof raw === "object" && raw !== null && !Array.isArray(raw)) return raw as Row;
+	if (typeof raw !== "string") return {};
+	try {
+		const parsed: unknown = JSON.parse(raw);
