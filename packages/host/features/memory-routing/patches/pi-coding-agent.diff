+import type { ModelRegistry } from "../config/model-registry";
+import type { Settings } from "../config/settings";
+
+export interface MemoryProjectEntrypoint {
+	path: string;
+	summary?: string;
+}
+
+export interface MemoryProjectRelation {
+	projectId: string;
+	kind: "uses" | "used-by" | "related";
+	status: "documented" | "design" | "historical";
+	summary: string;
+	sources: string[];
+}
+
+export interface MemoryRoutingProject {
+	id: string;
+	roots: string[];
+	description: string;
+	name?: string;
+	aliases?: string[];
+	entrypoints?: MemoryProjectEntrypoint[];
+	relations?: MemoryProjectRelation[];
+}
+
+export interface MemoryRoutingInput {
+	sourceId: string;
+	kind: "transcript" | "learn" | "retain" | "extension" | "migration";
+	content: string;
+	context?: string;
+	scopeHint?: "project" | "global";
+	sourceRefs: string[];
+}
+
+export interface MemoryRoutingDecision {
+	action: "store" | "skip" | "pending";
+	scope?: "project" | "global";
+	projectId?: string;
+	content: string;
+	sourceRefs: string[];
+	reason: string;
+}
+
+export interface MemoryRoutingStored {
+	id: string;
+	bank: string;
+	scope: "project" | "global";
+	projectId?: string;
+}
+
+export interface MemoryRoutingOutcome {
+	sourceId: string;
+	stored: MemoryRoutingStored[];
+	decisions: MemoryRoutingDecision[];
+	pending: boolean;
+	message?: string;
+}
+
+export interface MemoryRoutingContext {
+	settings: Settings;
+	modelRegistry: ModelRegistry;
+	/** Routing ledger namespace; credentials remain held by the supplied model registry. */
+	agentDir: string;
+	sessionId: string;
+	cwd: string;
+	signal?: AbortSignal;
+	/** Explicit per-call model-capacity policy; never persisted to profile settings. */
+	classification?: { model: "@memory"; limits: "model" };
+	/** Optional caller batch limits. Attempts/fallbacks remain one logical classification. */
+	budget?: {
+		maxInputChars: number | null;
+		maxOutputTokens: number | null;
+		maxModelCalls: number | null;
+		/** Populated only when a logical provider request is reserved. Not actual token usage. */
+		modelCalls: number;
+		reservedInputChars: number;
+		reservedOutputTokens: number;
+	};
+}
+
+export type MemoryRoutingCommit = (decision: MemoryRoutingDecision) => Promise<MemoryRoutingStored>;
+
+/** Persisted outside recall banks; no raw transcript is retained here. */
+export interface MemoryRoutingLedgerEntry {
+	key: string;
+	sourceId: string;
+	fingerprint: string;
+	kind: MemoryRoutingInput["kind"];
+	sourceRefs: string[];
+	status: "pending" | "completed";
+	decisions: MemoryRoutingDecision[];
+	stored: MemoryRoutingStored[];
+	updatedAt: string;
+	message?: string;
+}
