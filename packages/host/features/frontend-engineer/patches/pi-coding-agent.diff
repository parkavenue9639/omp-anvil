index 0000000000000000000000000000000000000000..8b2c54113d28423cb520a92abbdf760d9b0fa438
--- /dev/null
+++ b/src/task/frontend-mcp.ts
@@ -0,0 +1,145 @@
+import type { TSchema } from "@oh-my-pi/pi-ai";
+import type { MCPToolDetails } from "@oh-my-pi/pi-tui/tools/mcp";
+import type { CustomTool } from "../extensibility/custom-tools/types";
+import type { MCPManager, MCPManagerApi, MCPToolScope } from "../mcp/manager";
+
+export const FRONTEND_AGENT_NAME = "frontend-engineer";
+const FIGMA_TOOLS: Readonly<Record<string, true>> = {
+	get_design_context: true, get_metadata: true, get_screenshot: true,
+	get_variable_defs: true, get_code_connect_map: true,
+};
+const CONTEXT7_TOOLS: Readonly<Record<string, true>> = {
+	"resolve-library-id": true, "get-library-docs": true, "query-docs": true,
+};
+const SERVER_TOOLS: Readonly<Record<string, Readonly<Record<string, true>>>> = {
+	figma: FIGMA_TOOLS, "figma-cloud": FIGMA_TOOLS, "figma-desktop": FIGMA_TOOLS,
+	"figma-remote": FIGMA_TOOLS, context7: CONTEXT7_TOOLS,
+};
+const RESOURCE_URIS: Readonly<Record<string, true>> = {
+	"skill://figma/figma-design-to-code/SKILL.md": true,
+	"skill://figma/figma-use/SKILL.md": true,
+};
+function isServerAllowed(name: string): boolean { return Object.hasOwn(SERVER_TOOLS, name); }
+function isResourceServerAllowed(name: string): boolean {
+	return isServerAllowed(name) && SERVER_TOOLS[name] === FIGMA_TOOLS;
+}
+export function isFrontendMcpToolAllowed(tool: { mcpServerName?: string; mcpToolName?: string }): boolean {
+	const { mcpServerName: server, mcpToolName: method } = tool;
+	return server !== undefined && method !== undefined && isServerAllowed(server) && Object.hasOwn(SERVER_TOOLS[server], method);
+}
+export function filterFrontendMcpTools<T extends { mcpServerName?: string; mcpToolName?: string }>(tools: readonly T[]): T[] {
+	return tools.filter(isFrontendMcpToolAllowed);
+}
+export function isFrontendMcpResourceUriAllowed(uri: string): boolean { return Object.hasOwn(RESOURCE_URIS, uri); }
+
+type McpTool = CustomTool<TSchema, MCPToolDetails>;
+const managerViews = new WeakMap<MCPManagerApi, MCPManagerApi>();
+
+/** A filtered live view; connections, configuration and callbacks remain owner-bound. */
+
+type McpOwnerObservers = Pick<MCPManager, "getAllServerNames" | "getConnectionStatus" | "waitForStartup" |
+	"getNotificationState" | "addConnectionStatusListener" | "addCatalogChangeListener">;
+function hasOwnerObservers(source: MCPManagerApi): source is MCPManagerApi & McpOwnerObservers {
+	return ["getAllServerNames", "getConnectionStatus", "waitForStartup", "getNotificationState",
+		"addConnectionStatusListener", "addCatalogChangeListener"].every(key => typeof Reflect.get(source, key) === "function");
+}
+export function frontendMcpManager(source: MCPManager): MCPManager;
+export function frontendMcpManager(source: MCPManagerApi): MCPManagerApi;
+export function frontendMcpManager(source: MCPManagerApi): MCPManagerApi {
+	const existing = managerViews.get(source);
+	if (existing) return existing;
+	const toolViews = new WeakMap<McpTool, Map<MCPToolScope | undefined, { server: string; method: string; view: McpTool }>>();
+	const getTools: MCPManagerApi["getTools"] = scope => source.getTools(scope).filter(isFrontendMcpToolAllowed).map(tool => {
+		const server = tool.mcpServerName!, method = tool.mcpToolName!;
+		let scopedViews = toolViews.get(tool);
+		if (!scopedViews) { scopedViews = new Map(); toolViews.set(tool, scopedViews); }
+		const cached = scopedViews.get(scope);
+		if (cached?.server === server && cached.method === method) return cached.view;
+		const execute: McpTool["execute"] = async (...args) => {
+			const current = source.getTools(scope).find(candidate => candidate.mcpServerName === server &&
+				candidate.mcpToolName === method && isFrontendMcpToolAllowed(candidate));
+			if (!current) throw new Error(`Frontend MCP tool unavailable: ${server}/${method}`);
+			return current.execute(...args);
+		};
+		const bound = new Map<PropertyKey, unknown>();
+		const view = new Proxy(tool, {
+			get(target, key) {
+				if (key === "execute") return execute;
+				const value = Reflect.get(target, key, target);
+				if (typeof value !== "function") return value;
+				if (!bound.has(key)) bound.set(key, value.bind(target));
+				return bound.get(key);
+			},
+			set() { throw new Error("Frontend MCP tool views are read-only"); },
+		});
+		scopedViews.set(scope, { server, method, view });
+		return view;
+	});
+	const getServerResources: MCPManagerApi["getServerResources"] = name => {
+		if (!isResourceServerAllowed(name)) return undefined;
+		const catalog = source.getServerResources(name);
+		return catalog && { resources: catalog.resources.filter(resource => isFrontendMcpResourceUriAllowed(resource.uri)), templates: [] };
+	};
+	const readServerResource: MCPManagerApi["readServerResource"] = async (name, uri, options) => {
+		if (!isResourceServerAllowed(name) || !isFrontendMcpResourceUriAllowed(uri)) throw new Error(`Frontend MCP resource denied: ${name}/${uri}`);
+		if (!getServerResources(name)?.resources.some(resource => resource.uri === uri)) throw new Error(`Frontend MCP resource unavailable: ${name}/${uri}`);
+		const result = await source.readServerResource(name, uri, options);
+		if (result?.contents.some(content => content.uri !== uri)) throw new Error(`Frontend MCP resource returned an unrelated URI: ${name}/${uri}`);
+		return result;
+	};
+	const deny = (): never => { throw new Error("Frontend MCP view does not own connections, configuration, or prompts"); };
+	const methods: MCPManagerApi & Partial<MCPManager> = {
+		getTools, getServerResources, readServerResource,
+		openToolScope: (scope, seed) => source.openToolScope?.(scope, seed),
+		trackToolCall: (scope, id) => (source.trackToolCall ? source.trackToolCall(scope, id) : () => {}),
+		addToolsChangedListener: listener => source.addToolsChangedListener(listener),
+		waitForPendingConnections: () => source.waitForPendingConnections(),
+		getConnectedServers: () => source.getConnectedServers().filter(isServerAllowed),
+		ensureServerResources: async name => { if (isResourceServerAllowed(name)) await source.ensureServerResources(name); },
+		getServerInstructions: () => new Map([...source.getServerInstructions()].filter(([name]) => isServerAllowed(name))),
+		reconcileBrowserFilter: async () => deny(),
+		addNotificationListener: listener => source.addNotificationListener((server, method, params) => {
+			if (!isServerAllowed(server)) return;
+			if (method === "notifications/tools/list_changed") listener(server, method, undefined);
+			else if (isResourceServerAllowed(server)) {
+				if (method === "notifications/resources/list_changed") listener(server, method, undefined);
+				else if (method === "notifications/resources/updated" && params && typeof params === "object" &&
+					"uri" in params && typeof params.uri === "string" && isFrontendMcpResourceUriAllowed(params.uri)) listener(server, method, { uri: params.uri });
+			}
+		}),
+	};
+	// Owner-only observers do not exist on a remote manager. Preserve them only
+	// when the source actually supplies the concrete owner surface.
+	if (hasOwnerObservers(source)) {
+		const owner = source;
+		Object.assign(methods, {
+			getAllServerNames: () => owner.getAllServerNames().filter(isServerAllowed),
+			getConnectionStatus: (name: string) => isServerAllowed(name) ? owner.getConnectionStatus(name) : "disconnected",
+			getServerPrompts: () => [],
+			executePrompt: async () => deny(),
+			waitForStartup: async (timeoutMs: number) => {
+				const status = await owner.waitForStartup(timeoutMs);
+				return { connected: status.connected.filter(isServerAllowed), pending: status.pending.filter(isServerAllowed), failed: status.failed.filter(server => isServerAllowed(server.name)) };
+			},
+			getNotificationState: () => {
+				const state = owner.getNotificationState();
+				const subscriptions = new Map<string, ReadonlySet<string>>();
+				for (const [name, uris] of state.subscriptions) if (isResourceServerAllowed(name)) subscriptions.set(name, new Set([...uris].filter(isFrontendMcpResourceUriAllowed)));
+				return { enabled: state.enabled, subscriptions };
+			},
+			addConnectionStatusListener: (listener: Parameters<MCPManager["addConnectionStatusListener"]>[0]) => owner.addConnectionStatusListener(event => {
+				if (event.type === "connecting") { const serverNames = event.serverNames.filter(isServerAllowed); if (serverNames.length) listener({ ...event, serverNames }); }
+				else if (isServerAllowed(event.serverName)) listener(event);
+			}),
+			addCatalogChangeListener: (listener: Parameters<MCPManager["addCatalogChangeListener"]>[0]) => owner.addCatalogChangeListener(event => {
+				if (event.kind === "resources" && isResourceServerAllowed(event.serverName)) listener(event);
+			}),
+		} satisfies Partial<MCPManager>);
+	}
+	const view = new Proxy(source, {
+		get(_target, key) { if (key === "then") return undefined; return Object.hasOwn(methods, key) ? Reflect.get(methods, key) : deny; },
+		set: deny, defineProperty: deny, deleteProperty: deny,
+	});
+	managerViews.set(source, view); managerViews.set(view, view);
+	return view;
+}
