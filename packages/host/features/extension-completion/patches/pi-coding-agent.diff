new file mode 100644
index 0000000000000000000000000000000000000000..9215faf74309a9e5d9174973529178232f1b944f
--- /dev/null
+++ b/src/extensibility/extensions/completion.ts
@@ -0,0 +1,110 @@
+import { type AgentTelemetryConfig, instrumentedCompleteSimple, resolveTelemetry, Tokenizer, MESSAGE_FRAMING_TOKENS, OUTPUT_FIT_HEADWAY_TOKENS } from "@oh-my-pi/pi-agent-core";
+import { randomUUID } from "node:crypto";
+import { streamSimple, type AssistantMessage, type Context } from "@oh-my-pi/pi-ai";
+import type { Effort } from "@oh-my-pi/pi-catalog/effort";
+import { getSupportedEfforts } from "@oh-my-pi/pi-catalog/model-thinking";
+import type { ModelRegistry } from "../../config/model-registry";
+import type { JudgmentUsage } from "../../judgment";
+import type { CostGate } from "../../session/cost-gate";
+import type { ExtensionContext } from "./types";
+
+export type ExtensionCompletionErrorCode = "EXTENSION_COMPLETION_UNAVAILABLE" | "EXTENSION_COMPLETION_MODEL_UNAVAILABLE" |
+	"EXTENSION_COMPLETION_CAPACITY" | "EXTENSION_COMPLETION_CREDENTIALS" | "EXTENSION_COMPLETION_COST_GATE" |
+	"EXTENSION_COMPLETION_CANCELLED" | "EXTENSION_COMPLETION_PROVIDER_FAILED";
+
+/** Safe public failure: never includes provider exception text, credentials, or abort reasons. */
+export class ExtensionCompletionError extends Error {
+	constructor(readonly code: ExtensionCompletionErrorCode, message: string) {
+		super(message);
+		this.name = "ExtensionCompletionError";
+	}
+}
+
+/** Host-owned dependencies; none of these mutable controls is exposed through ctx.complete. */
+export interface ExtensionCompletionDeps {
+	registry: ModelRegistry;
+	sessionId: string;
+	purpose: string;
+	assertActive(): void;
+	costGate?: CostGate;
+	telemetry?: AgentTelemetryConfig;
+	onUsage?: (usage: JudgmentUsage) => void;
+}
+
+/** Exactly one toolless native request, never role selection, history, or model mutation. */
+export function createExtensionCompletion(deps: ExtensionCompletionDeps): ExtensionContext["complete"] {
+	return async (request, options) => {
+		let failureCode: ExtensionCompletionErrorCode = "EXTENSION_COMPLETION_PROVIDER_FAILED";
+		try {
+			const assertActive = () => {
+				if (options?.signal?.aborted) throw new ExtensionCompletionError("EXTENSION_COMPLETION_CANCELLED", "ctx.complete: request cancelled");
+				deps.assertActive();
+			};
+			assertActive();
+			const model = deps.registry.getAvailable().find(candidate => `${candidate.provider}/${candidate.id}` === request.model);
+			if (!model) throw new ExtensionCompletionError("EXTENSION_COMPLETION_MODEL_UNAVAILABLE", "ctx.complete: exact model unavailable");
+			// An explicit effort is part of the exact identity: unsupported values fail instead of clamping.
+			const reasoning = request.reasoning as Effort | undefined;
+			if (reasoning !== undefined && (!model.thinking || !getSupportedEfforts(model).includes(reasoning))) {
+				throw new ExtensionCompletionError("EXTENSION_COMPLETION_MODEL_UNAVAILABLE", "ctx.complete: requested effort unsupported by model");
+			}
+			const context: Context = {
+				systemPrompt: [request.system],
+				messages: [{ role: "user", content: [{ type: "text", text: request.prompt }], timestamp: Date.now() }],
+			};
+			const tokenizer = new Tokenizer(model);
+			const inputTokens = tokenizer.countTokens(context.systemPrompt!) + tokenizer.countMessages(context.messages);
+			// Same local estimate margin and framing as the native output-budget fitter. Unlike a
+			// conversational turn this cannot compact, so no minimum-output floor may overflow.
+			const room = model.contextWindow - inputTokens - Math.ceil(inputTokens / 10) - MESSAGE_FRAMING_TOKENS - OUTPUT_FIT_HEADWAY_TOKENS;
+			if (room <= 0) throw new ExtensionCompletionError("EXTENSION_COMPLETION_CAPACITY", "ctx.complete: prompt exceeds model context capacity");
+			const maxTokens = Math.min(model.maxTokens, room);
+			failureCode = "EXTENSION_COMPLETION_CREDENTIALS";
+			const key = await deps.registry.getApiKey(model, deps.sessionId, { signal: options?.signal });
+			assertActive();
+			if (!key) throw new ExtensionCompletionError("EXTENSION_COMPLETION_CREDENTIALS", "ctx.complete: no credentials for requested model");
+			const headers = await deps.registry.resolveModelHeaders(model, options?.signal);
+			assertActive();
+			failureCode = "EXTENSION_COMPLETION_COST_GATE";
+			deps.costGate?.admit();
+			failureCode = "EXTENSION_COMPLETION_PROVIDER_FAILED";
+			const response: AssistantMessage = await instrumentedCompleteSimple(model, context, {
+				apiKey: deps.registry.resolver(model, deps.sessionId),
+				headers,
+				// Provider threads/cascades are request-local; sticky authentication and accounting
+				// deliberately retain the owning root session id above and below.
+				sessionId: randomUUID(),
+				signal: options?.signal,
+				maxTokens,
+				...(reasoning !== undefined ? { reasoning } : {}),
+			}, {
+				telemetry: resolveTelemetry(deps.telemetry, deps.sessionId),
+				oneshotKind: "extension_completion",
+				attributes: { "omp.extension.purpose": deps.purpose },
+				completeImpl: async (requestModel, requestContext, requestOptions) => {
+					// completeSimple re-samples ThinkingLoop failures. A bridge call is one native
+					// stream only, still protected by streamSimple's thinking-loop guard.
+					const stream = streamSimple(requestModel, requestContext, requestOptions);
+					for await (const _event of stream) {
+						// Drain deltas without retaining the streamed response history.
+					}
+					const response = await stream.result();
+					// Record the actual result before telemetry finalization or cancellation checks
+					// can reject it. No response means no fabricated usage entry.
+					deps.costGate?.record(response.usage.cost.total);
+					deps.onUsage?.({ purpose: deps.purpose, role: "explicit", api: response.api, provider: response.provider,
+						model: response.model, usage: response.usage, stopReason: response.stopReason, errorMessage: response.errorMessage });
+					return response;
+				},
+			});
+			assertActive();
+			return response;
+		} catch (error) {
+			if (error instanceof ExtensionCompletionError) throw error;
+			if (options?.signal?.aborted) throw new ExtensionCompletionError("EXTENSION_COMPLETION_CANCELLED", "ctx.complete: request cancelled");
+			throw new ExtensionCompletionError(failureCode, failureCode === "EXTENSION_COMPLETION_COST_GATE"
+				? "ctx.complete: Cost cap reached; request refused by host cost gate"
+				: "ctx.complete: native request failed");
+		}
+	};
+}
