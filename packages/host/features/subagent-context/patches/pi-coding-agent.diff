+const MAX_TARGET_REPO_DIRS = 8;
+const MAX_EXISTING_ANCESTOR_HOPS = 4;
+
+function stripTrailingPathNoise(rawPath: string): string {
+	return rawPath
+		.replace(/[.,;:!?)'"\]]+$/, "")
+		.replace(/:\d+(?::\d+)?$/, "")
+		.replace(/[.,;:!?)'"\]]+$/, "");
+}
+
+function extractReferencedPaths(cwd: string, ...texts: Array<string | undefined>): string[] {
+	const results: string[] = [];
+	const seen = new Set<string>();
+	const homeDir = os.homedir();
+	const pushCandidate = (candidate: string | undefined): void => {
+		if (!candidate) return;
+		const cleaned = stripTrailingPathNoise(candidate.trim());
+		if (!cleaned || cleaned === "/" || !cleaned.includes("/")) return;
+		const resolved = path.resolve(cwd, cleaned);
+		if (seen.has(resolved)) return;
+		seen.add(resolved);
+		results.push(resolved);
+	};
+
+	for (const text of texts) {
+		if (!text) continue;
+		for (const match of text.matchAll(/file:\/\/(\/[^)\s"'`<>#\r\n]+)/g)) {
+			try {
+				pushCandidate(decodeURIComponent(match[1]!));
+			} catch {
+				pushCandidate(match[1]);
+			}
+		}
+		for (const match of text.matchAll(/(?:^|[\s(`"'\[,=])(~\/[A-Za-z0-9._\-\/@+]+)/g)) {
+			pushCandidate(path.join(homeDir, match[1]!.slice(2)));
+		}
+		for (const match of text.matchAll(/(?:^|[\s(`"'\[,=])(\/[A-Za-z0-9._\-\/@+]+)/g)) {
+			pushCandidate(match[1]);
+		}
+		for (const match of text.matchAll(/(?:^|[\s(`"'\[,=])(\.\.?\/[A-Za-z0-9._\-\/@+]+)/g)) {
+			pushCandidate(match[1]);
+		}
+	}
+	return results;
+}
+
+async function resolveCanonicalPath(targetPath: string): Promise<string> {
+	const resolved = path.resolve(targetPath);
+	try {
+		return await fs.realpath(resolved);
+	} catch {
+		return resolved;
+	}
+}
+
+function isWithinOrEqual(parentDir: string, childPath: string): boolean {
+	const rel = path.relative(parentDir, childPath);
+	return rel === "" || (!rel.startsWith("..") && !path.isAbsolute(rel));
+}
+
+function isLcpCheckoutRoot(root: string): { commonDir: string } | undefined {
+	try {
+		const canonicalRoot = realpathSync.native(root);
+		const launcher = JSON.parse(readFileSync(path.join(canonicalRoot, "packages/launcher/package.json"), "utf8"));
+		const guard = JSON.parse(readFileSync(path.join(canonicalRoot, "packages/risk-guard/package.json"), "utf8"));
+		if (launcher?.name !== "@lcp/launcher" || guard?.name !== "@lcp/risk-guard") return undefined;
+		const git = vcs.gitInfo(canonicalRoot);
+		if (!git || realpathSync.native(git.repoRoot) !== canonicalRoot) return undefined;
+		return { commonDir: realpathSync.native(git.commonDir) };
+	} catch {
+		return undefined;
+	}
+}
+
+function discoverLcpProductionBoundaryForSubagent(): { root?: string; sourceCommonDir?: string } {
+	let sourceCommonDir: string | undefined;
+	let cursor = path.resolve(import.meta.dir);
+	for (let hop = 0; hop < 8; hop++) {
+		const info = isLcpCheckoutRoot(cursor);
+		if (info) {
+			sourceCommonDir = info.commonDir;
+			break;
+		}
+		const parent = path.dirname(cursor);
+		if (parent === cursor) break;
+		cursor = parent;
+	}
+	const entryPath = process.env.LCP_PRODUCTION_ENTRY_FOR_TESTS?.trim() || path.join(os.homedir(), ".local/bin/lcp");
+	try {
+		const entry = realpathSync.native(entryPath);
+		const root = realpathSync.native(path.dirname(path.dirname(entry)));
+		if (realpathSync.native(path.join(root, "bin/lcp")) !== entry) return { sourceCommonDir };
+		if (!isLcpCheckoutRoot(root)) return { sourceCommonDir };
+		return { root, sourceCommonDir };
+	} catch {
+		return { sourceCommonDir };
+	}
+}
