+async function resolveExistingDir(candidatePath: string, homeCanonical: string): Promise<string | null> {
+	let current = path.resolve(candidatePath);
+	for (let hop = 0; hop <= MAX_EXISTING_ANCESTOR_HOPS; hop++) {
+		const canonicalCurrent = await resolveCanonicalPath(current);
+		if (canonicalCurrent === "/" || canonicalCurrent === homeCanonical) {
+			return null;
+		}
+		try {
+			const stat = await fs.stat(current);
+			return stat.isDirectory() ? current : path.dirname(current);
+		} catch {
+			const parent = path.dirname(current);
+			if (parent === current) return null;
+			current = parent;
+		}
+	}
+	return null;
+}
