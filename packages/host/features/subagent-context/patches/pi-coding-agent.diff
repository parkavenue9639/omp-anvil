+	}
+
+	for (const rawDir of additionalDirectories) {
+		if (!rawDir) continue;
+		const resolvedDir = path.resolve(rawDir);
+		const canonDir = await canonicalSkillPath(resolvedDir);
+		if (seenDirs.has(canonDir)) continue;
+		seenDirs.add(canonDir);
+		const extra = await loadCapability<CapabilitySkill>(skillCapability.id, {
+			cwd: resolvedDir,
+			disabledExtensions,
+			extensionRoots,
+		});
+		if (extra.warnings) warnings.push(...extra.warnings);
+		for (const capSkill of extra.all) {
+			if (capSkill.level !== "project") continue;
+			await addCandidate(capSkill);
+		}
+	}
+
+	return { all, warnings };
+}
