+import { SelectList } from "@oh-my-pi/pi-tui";
+import { OverlayPanel } from "@oh-my-pi/pi-tui/chrome/overlay-box";
+import { SelectListSheet } from "@oh-my-pi/pi-tui/native/picker";
+import type { DescribeContext, NativeNode, NativeUiEvent } from "@oh-my-pi/pi-tui/native/node";
+import { getSelectListTheme } from "@oh-my-pi/pi-tui/theme";
+
+/** A role binding, not a concrete-model or effort selection. */
+export class AgentRoleSelectorComponent extends OverlayPanel {
+	readonly #list: SelectList;
+	readonly #sheet: SelectListSheet;
+
+	constructor(
+		roles: readonly string[],
+		current: string | undefined,
+		onSelect: (role: string | undefined) => void,
+		onCancel: () => void,
+	) {
+		super("Task role (session-only)", "omp.overlay.task-role");
+		const choices = [
+			{ value: "", label: "Agent default (reset override)" },
+			...roles.map(role => ({ value: role, label: role })),
+		];
+		this.#list = new SelectList(choices, 12, getSelectListTheme());
+		const index = choices.findIndex(choice => choice.value === (current ?? ""));
+		if (index >= 0) this.#list.setSelectedIndex(index);
+		this.#list.onSelect = item => onSelect(item.value || undefined);
+		this.#list.onCancel = onCancel;
+		this.addChild(this.#list);
+		this.#sheet = new SelectListSheet(this.#list, {
+			title: "Task role (session-only)",
+			subtitle: "Choose one configured role; /agents persists a binding.",
+			noun: "roles",
+			current: [current ?? ""],
+		});
+	}
+
+	handleInput(data: string): void {
+		this.#list.handleInput(data);
+	}
+
+	override describe(cx: DescribeContext): NativeNode | null {
+		return cx.supports("picker") ? this.#sheet.describe() : super.describe(cx);
+	}
+
+	handleNativeEvent(event: NativeUiEvent): void {
+		this.#sheet.handle(event);
+	}
+}
