index 0000000000000000000000000000000000000000..1370d3d90bd0172d80826aa2d420ca307f627ae9
--- /dev/null
+++ b/src/memory-routing/redact.ts
@@ -0,0 +1,37 @@
+import { redactMemorySecrets } from "../memory-backend/redact";
+
+/** Redact candidate text and repository metadata before provider or disk I/O. */
+export function redactRoutingSecrets(text: string): string {
+	return redactMemorySecrets(redactUrlCredentials(text))
+		.replace(/-----BEGIN [^-]*PRIVATE KEY-----[\s\S]*?(?:-----END [^-]*PRIVATE KEY-----|$)/g, "[REDACTED PRIVATE KEY]")
+		.replace(/\b(Bearer|Basic)\s+[A-Za-z0-9+/=_\-.]+/gi, "$1 [REDACTED]")
+		.replace(/((?<![\w.-])(?:["']?)(?:[\w.-]*(?:api[_-]?key|access[_-]?token|refresh[_-]?token|password|passwd|secret|authorization|credential)[\w.-]*)(?:["']?)\s*[:=]\s*)(?:"[^"\n]*"|'[^'\n]*'|[^\s,;}]+)/gi, "$1[REDACTED]")
+		.replace(/((?<![\w.-])["']?[\w.-]*token["']?\s*[:=]\s*)(?:"[^"\n]*"|'[^'\n]*'|[^\s,;}]+)/gi, "$1[REDACTED]")
+		.replace(/(https?:\/\/)[^\s/@:]+:[^\s/@]+@/gi, "$1[REDACTED]@");
+}
+
+/** Decode URL query names before redacting credentials; never fetch the URL. */
+function redactUrlCredentials(input: string): string {
+	return input.replace(/https?:\/\/[^\s<>"']+/gi, text => {
+		try {
+			const url = new URL(text);
+			let changed = false;
+			if (url.username || url.password) {
+				url.username = "REDACTED";
+				url.password = "";
+				changed = true;
+			}
+			const parameters = new URLSearchParams();
+			for (const [key, value] of url.searchParams) {
+				const sensitive = /(?:api[_-]?key|access[_-]?key|private[_-]?key|(?:^|[_-])key$|token$|password|passwd|secret|authorization|credential|signature|^sig$|^auth$)/i.test(key);
+				parameters.append(key, sensitive ? "REDACTED" : value);
+				changed ||= sensitive;
+			}
+			if (!changed) return text;
+			url.search = parameters.toString();
+			return url.toString();
+		} catch {
+			return text;
+		}
+	});
+}
diff --git a/src/memory-routing/service.ts b/src/memory-routing/service.ts
