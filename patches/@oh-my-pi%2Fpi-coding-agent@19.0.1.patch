+async function resolveSpawnWorkingDirectory(
+	request: StructuredSubagentRequest,
+	isIsolated: boolean,
+): Promise<{ resolvedCwd?: string; boundWorktree?: string }> {
+	if (request.cwd === undefined) return {};
+	if (isIsolated) {
+		throw new StructuredSubagentError(
+			"preflight",
+			"`cwd` cannot be combined with `isolated: true`; pass an existing directory or let isolation create a temporary worktree.",
+		);
+	}
+	const syntaxProblem = invalidSpawnCwdReason(request.cwd, "Subagent");
+	if (syntaxProblem) {
+		throw new StructuredSubagentError("preflight", syntaxProblem);
+	}
+	const raw = request.cwd.trim();
+	const candidate = path.resolve(request.session.cwd, raw);
+	let stat: Awaited<ReturnType<typeof fs.stat>>;
+	try {
+		stat = await fs.stat(candidate);
+	} catch {
+		throw new StructuredSubagentError("preflight", `Subagent \`cwd\` does not exist: ${raw}`);
+	}
+	if (!stat.isDirectory()) {
+		throw new StructuredSubagentError("preflight", `Subagent \`cwd\` must be an existing directory: ${raw}`);
+	}
+	const canonicalTarget = await resolveCanonicalPath(candidate);
+	const canonicalSessionCwd = await resolveCanonicalPath(request.session.cwd);
+	const production = discoverLcpProductionBoundaryForSubagent();
+	if (production.root && isWithinOrEqual(production.root, canonicalTarget)) {
+		throw new StructuredSubagentError(
+			"preflight",
+			`Subagent \`cwd\` refuses the protected LCP production checkout: ${canonicalTarget}`,
+		);
+	}
+	const targetGit = vcs.gitInfo(canonicalTarget);
+	const targetRepoRoot = targetGit ? await resolveCanonicalPath(targetGit.repoRoot) : undefined;
+	const targetCommonDir = targetGit ? await resolveCanonicalPath(targetGit.commonDir) : undefined;
+	if (targetGit && targetCommonDir) {
+		const targetGitDir = await resolveCanonicalPath(targetGit.gitDir);
+		const targetGitEntry = await resolveCanonicalPath(targetGit.gitEntryPath);
+		if (
+			isWithinOrEqual(targetCommonDir, canonicalTarget) ||
+			isWithinOrEqual(targetGitDir, canonicalTarget) ||
+			canonicalTarget === targetGitEntry
+		) {
+			throw new StructuredSubagentError(
+				"preflight",
+				`Subagent \`cwd\` cannot point inside Git metadata (${canonicalTarget}).`,
+			);
+		}
+	}
+	const sessionGit = vcs.gitInfo(canonicalSessionCwd);
+	const sessionRepoRoot = sessionGit ? await resolveCanonicalPath(sessionGit.repoRoot) : undefined;
+	const workspaceRoots = await Promise.all(
+		[request.session.cwd, ...(request.session.additionalDirectories ?? [])].map(resolveCanonicalPath),
+	);
+	if (workspaceRoots.some(root => isWithinOrEqual(root, canonicalTarget))) {
+		if (canonicalTarget === canonicalSessionCwd) return {};
+		return {
+			resolvedCwd: canonicalTarget,
+			boundWorktree: targetRepoRoot && targetRepoRoot !== sessionRepoRoot ? targetRepoRoot : undefined,
+		};
+	}
+	if (!targetGit || !targetRepoRoot || !targetCommonDir) {
+		throw new StructuredSubagentError(
+			"preflight",
+			`Subagent \`cwd\` must be inside the workspace or an existing registered git worktree of the same repository: ${canonicalTarget}`,
+		);
+	}
+	if (!production.root && production.sourceCommonDir && targetCommonDir === production.sourceCommonDir) {
+		throw new StructuredSubagentError(
+			"preflight",
+			`Subagent \`cwd\` cannot verify the LCP production boundary while delegating into sibling worktree: ${canonicalTarget}`,
+		);
+	}
+	for (const wsRoot of workspaceRoots) {
+		const repo = vcs.git(wsRoot);
+		const info = repo?.info();
+		if (!repo || !info) continue;
+		const wsCommonDir = await resolveCanonicalPath(info.commonDir);
+		if (wsCommonDir !== targetCommonDir) continue;
+		const worktrees = await repo.worktrees(request.signal);
+		for (const entry of worktrees) {
+			const wtRoot = await resolveCanonicalPath(entry.path);
+			if (wtRoot !== targetRepoRoot || !isWithinOrEqual(wtRoot, canonicalTarget)) continue;
+			const fresh = vcs.gitInfo(wtRoot);
+			if (!fresh) continue;
+			if (
+				(await resolveCanonicalPath(fresh.repoRoot)) === wtRoot &&
+				(await resolveCanonicalPath(fresh.commonDir)) === wsCommonDir
+			) {
+				return {
+					resolvedCwd: canonicalTarget,
+					boundWorktree: wtRoot !== sessionRepoRoot ? wtRoot : undefined,
+				};
+			}
+		}
+	}
+	throw new StructuredSubagentError(
+		"preflight",
+		`Subagent \`cwd\` must be inside the workspace or an existing registered git worktree of the same repository: ${canonicalTarget}`,
+	);
+}
