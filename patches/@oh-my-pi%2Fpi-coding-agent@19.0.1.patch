+	}
+	if (!Array.isArray(ids) || ids.length < 1 || ids.length > 2 || new Set(ids).size !== ids.length
+		|| ids.some(id => typeof id !== "string" || !id.trim() || id !== id.trim() || id === "*")) {
+		throw new Error("projectIds must contain one or two distinct exact registered project IDs.");
+	}
+	const catalog = listRegisteredRoutingProjects(ownerSettings);
+	return [...ids].sort().map(id => {
+		const project = catalog.find(entry => entry.id === id);
+		if (!project) throw new Error(`Unknown memory project: ${JSON.stringify(id)}`);
+		const bank = routingProjectBank(caller.baseBank, id);
+		// Compute the pinned BankManager layout without constructing or initializing a bank.
+		return { project, bank, path: join(dirname(caller.dbPath), "banks", bank, "mnemopi.db") };
+	});
+}
+
+function digest(value: unknown): string {
+	return createHash("sha256").update(JSON.stringify(value)).digest("base64url");
+}
+
+function encodeCursor(value: Continuation): string {
+	const body = Buffer.from(JSON.stringify(value)).toString("base64url");
+	return `${body}.${digest(body)}`;
+}
+
+function decodeCursor(cursor: string | undefined, binding: string): Continuation {
+	if (cursor === undefined) return { binding, offset: 0, time: new Date().toISOString() };
+	if (typeof cursor !== "string" || cursor.length > 1500 || !/^[\w-]+\.[\w-]+$/.test(cursor)) {
+		throw new Error("Invalid project memory cursor.");
+	}
+	const [body, checksum] = cursor.split(".") as [string, string];
+	if (checksum !== digest(body)) throw new Error("Invalid project memory cursor.");
+	let value: Continuation;
+	try { value = JSON.parse(Buffer.from(body, "base64url").toString("utf8")); }
+	catch { throw new Error("Invalid project memory cursor."); }
+	if (!value || value.binding !== binding || !Number.isInteger(value.offset) || value.offset < 1 || value.offset >= WINDOW
+		|| typeof value.time !== "string" || !Number.isFinite(Date.parse(value.time)) || typeof value.window !== "string") {
+		throw new Error("Project memory cursor does not match this query and target set.");
+	}
+	return value;
+}
+
+// Native recall tolerates absent tables in several fallback paths. A foreign
+// incompatible database must be an explicit error, never an apparent empty bank.
+function validateSchema(db: Database): void {
+	const memory = "id,content,source,timestamp,session_id,importance,metadata_json,veracity,memory_type,recall_count,last_recalled,valid_until,superseded_by,scope,author_id,author_type,channel_id,event_date,event_date_precision,temporal_tags,created_at";
+	try {
+		db.query(`SELECT ${memory},embed_text FROM working_memory LIMIT 0`).all();
+		db.query(`SELECT ${memory},rowid,summary_of,tier FROM episodic_memory LIMIT 0`).all();
+		db.query("SELECT fact_id,subject,predicate,object,timestamp,confidence,session_id,source_msg_id,created_at FROM facts LIMIT 0").all();
+		db.query("SELECT memory_id,embedding_json FROM memory_embeddings LIMIT 0").all();
+	} catch (error) {
+		throw new Error(`Incompatible or corrupt project memory schema: ${error instanceof Error ? error.message : String(error)}`);
+	}
+}
+
+function readonlyBeam(db: Database, target: Target, owner: ReadCaller): BeamMemoryState {
+	const caller = owner.beam;
+	return {
+		db, dbPath: target.path, sessionId: target.bank, channelId: target.bank,
+		authorId: caller.authorId, authorType: caller.authorType, useCloud: caller.useCloud,
+		config: caller.config,
+		caches: { timestampParse: new Map(), extractionBuffer: [] },
+		pluginManager: null, annotations: null, triples: null, episodicGraph: null, veracityConsolidator: null,
+	};
+}
+
+function metadata(row: Row): Row {
+	const raw = row.metadata ?? row.metadata_json;
+	if (typeof raw === "object" && raw !== null && !Array.isArray(raw)) return raw as Row;
+	if (typeof raw !== "string") return {};
+	try {
+		const parsed: unknown = JSON.parse(raw);
+		return typeof parsed === "object" && parsed !== null && !Array.isArray(parsed) ? parsed as Row : {};
+	} catch { return {}; }
+}
+
+function text(value: unknown): string | undefined {
+	return typeof value === "string" ? redactRoutingSecrets(value) : undefined;
+}
+
+function retired(row: Row): boolean {
+	return (typeof row.superseded_by === "string" && row.superseded_by.length > 0)
+		|| (typeof row.valid_until === "string" && Date.parse(row.valid_until) <= Date.now());
+}
+
+async function recordFor(beam: BeamMemoryState, target: Target, id: string): Promise<ProjectMemoryRecord | null> {
+	// Like state.ts, keep the native embedding stack off the CLI startup graph.
+	const { get } = await import("@oh-my-pi/pi-mnemopi/core/beam/store");
+	const row = get(beam, id);
+	if (!row) return null;
+	const store = row.memory_store;
+	if (store !== "working" && store !== "episodic" && store !== "fact") throw new Error("Unsupported project memory store.");
+	// Native get's working lookup predates session filtering. Keep this new
+	// explicit service inside the target identity even for mixed legacy banks.
+	if (store !== "fact") {
+		const visible = beam.db.query(`SELECT id FROM ${store === "working" ? "working_memory" : "episodic_memory"} WHERE id = ? AND (session_id = ? OR scope = 'global' OR channel_id = ?)`)
+			.get(id, beam.sessionId, beam.channelId);
+		if (!visible) return null;
+	}
+	const ownMetadata = metadata(row);
+	const sourceId = ownMetadata.source_msg_id;
+	const source = store === "fact" && typeof sourceId === "string" && sourceId.length > 0 ? get(beam, sourceId) : null;
+	const sourceMetadata = source ? metadata(source) : {};
+	const refs = new Set<string>();
+	for (const meta of [ownMetadata, sourceMetadata]) {
+		for (const field of [meta.source_refs, meta.sourceRefs]) {
+			if (Array.isArray(field)) for (const ref of field) if (typeof ref === "string") refs.add(redactRoutingSecrets(ref));
+		}
+	}
+	if (typeof sourceId === "string" && sourceId) refs.add(redactRoutingSecrets(sourceId));
+	return {
+		id, projectId: target.project.id,
+		projectName: text(target.project.name) ?? basename(target.project.roots[0] ?? "") ?? target.project.id,
+		bank: target.bank, store, content: text(row.content) ?? "",
+		source: text(row.source), timestamp: text(row.timestamp), createdAt: text(row.created_at),
+		veracity: text(row.veracity ?? source?.veracity),
+		evidenceStatus: text([
+			ownMetadata.evidenceStatus, ownMetadata.evidence_status, ownMetadata.freshness,
+			sourceMetadata.evidenceStatus, sourceMetadata.evidence_status, sourceMetadata.freshness,
+		].find(value => typeof value === "string" && value.trim().length > 0)) ?? "unspecified",
+		sourceRefs: [...refs], retired: retired(row) || (source !== null && retired(source)),
+	};
+}
+
+function preview(record: ProjectMemoryRecord, content: string, score: number | undefined): MemoryBackendSearchItem {
+	let truncated = content !== record.content;
+	function clip(value: string | undefined, max: number): string | undefined {
+		if (value === undefined || value.length <= max) return value;
+		truncated = true;
+		return `${value.slice(0, max - 1)}…`;
+	}
+	const item: MemoryBackendSearchItem = {
+		id: record.id, projectId: record.projectId, bank: record.bank,
+		projectName: clip(record.projectName, 160), content: clip(redactRoutingSecrets(content), 1000)!, score,
+		source: clip(record.source, 256), timestamp: clip(record.timestamp, 128),
+		veracity: clip(record.veracity, 64), evidenceStatus: clip(record.evidenceStatus, 128),
+		sourceRefs: record.sourceRefs.slice(0, 8).map(ref => clip(ref, 160)!),
+		readUrl: `memory://projects/${encodeURIComponent(record.projectId)}/memories/${encodeURIComponent(record.id)}`,
+	};
+	if (record.sourceRefs.length > 8) truncated = true;
+	if (truncated) item.truncated = true;
+	return item;
+}
+
+export async function recallProjectMemories(
+	settings: Settings, state: MnemopiSessionState, request: ProjectMemoryRecallRequest,
+): Promise<MemoryBackendSearchResult> {
+	return recallWithCaller(settings, sessionCaller(state), request);
+}
+
+async function recallWithCaller(
+	settings: Settings, caller: ReadCaller, request: ProjectMemoryRecallRequest, noInference = false,
+): Promise<MemoryBackendSearchResult> {
+	if (typeof request.query !== "string" || !request.query.trim() || request.query.length > 4000) throw new Error("query must contain 1..4000 characters.");
+	const limit = request.limit ?? 5;
+	if (!Number.isInteger(limit) || limit < 1 || limit > 10) throw new Error("limit must be an integer from 1 to 10.");
+	const selected = targets(settings, caller, request.projectIds);
+	const query = request.query.trim();
+	const binding = digest([query, selected.map(target => [target.project.id, target.path]), ...(noInference ? ["no-inference"] : [])]);
+	const continuation = decodeCursor(request.cursor, binding);
+	request.signal?.throwIfAborted();
+	await loadMnemopiCore();
+	// Native modules load only at this explicit async boundary, after the shared
+	// embedding initializer is installed; static imports would eagerly load them.
+	const [{ recall, factRecall }, { withMnemopiRuntimeOptions }] = await Promise.all([
+		import("@oh-my-pi/pi-mnemopi/core/beam/recall"), import("@oh-my-pi/pi-mnemopi/core/runtime-options"),
+	]);
+	const projects: NonNullable<MemoryBackendSearchResult["projects"]> = [];
+	const ranked: MemoryBackendSearchItem[] = [];
+	let capped = false;
+	for (const target of selected) {
+		request.signal?.throwIfAborted();
+		if (!existsSync(target.path)) { projects.push({ projectId: target.project.id, status: "uninitialized" }); continue; }
+		const db = new Database(target.path, { readonly: true });
+		try {
+			validateSchema(db);
+			const beam = readonlyBeam(db, target, caller);
+			const results = await withMnemopiRuntimeOptions(caller.runtimeOptions, () =>
+				recall(beam, query, WINDOW, { updateRecallCounts: false, channelId: target.bank, queryTime: continuation.time,
+					queryEmbedding: noInference ? null : undefined }));
+			const facts = factRecall(beam, query, WINDOW);
+			capped ||= results.length >= WINDOW || facts.length >= WINDOW;
+			const seen = new Set<string>();
+			for (const result of [...results, ...facts].sort((a, b) => (b.score ?? 0) - (a.score ?? 0))) {
+				if (seen.has(result.id)) continue;
+				seen.add(result.id);
+				const record = await recordFor(beam, target, result.id);
+				if (record && !record.retired) ranked.push(preview(record, result.content, result.score));
+			}
+			projects.push({ projectId: target.project.id, status: "ready" });
+		} finally { db.close(); }
+	}
+	request.signal?.throwIfAborted();
+	ranked.sort((a, b) => (b.score ?? 0) - (a.score ?? 0) || a.projectId!.localeCompare(b.projectId!) || a.id!.localeCompare(b.id!));
+	capped ||= ranked.length >= WINDOW;
+	const window = ranked.slice(0, WINDOW);
+	const fingerprint = digest(window.map(item => [item.projectId, item.id, item.content, item.sourceRefs]));
+	if (continuation.window !== undefined && continuation.window !== fingerprint) throw new Error("Project memory results changed; restart this query without a cursor.");
+	const response: MemoryBackendSearchResult = { backend: "mnemopi", query, count: 0, items: [], projects };
+	let offset = continuation.offset;
+	while (offset < window.length && response.items.length < limit) {
+		const item = window[offset]!;
+		// Reserve room for the continuation and explicit bounded-window notice.
+		if (JSON.stringify({ ...response, items: [...response.items, item] }).length > PAGE_BUDGET - 1000) {
+			if (response.items.length === 0) throw new Error("Project memory identifiers exceed the page budget; refine the target query.");
+			break;
+		}
+		response.items.push(item);
+		offset++;
+	}
+	response.count = response.items.length;
+	if (offset < window.length) response.nextCursor = encodeCursor({ ...continuation, offset, window: fingerprint });
+	else if (capped) {
+		response.windowExhausted = true;
+		response.message = "The ranked 100-result window is exhausted. Refine the query to retrieve other memories; this is not an exhaustive bank scan.";
+	}
+	return response;
+}
+
+export async function readProjectMemory(
+	settings: Settings, state: MnemopiSessionState, projectId: string, id: string,
+): Promise<ProjectMemoryRecord> {
+	if (typeof id !== "string" || !id.trim() || id !== id.trim() || id.includes("\0")) throw new Error("An exact nonempty memory ID is required.");
+	const caller = sessionCaller(state);
+	const target = targets(settings, caller, [projectId])[0]!;
+	if (!existsSync(target.path)) throw new Error(`Project memory bank is uninitialized: ${projectId}`);
+	await loadMnemopiCore();
+	const db = new Database(target.path, { readonly: true });
+	try {
+		validateSchema(db);
+		const record = await recordFor(readonlyBeam(db, target, caller), target, id);
+		if (!record) throw new Error(`Memory ${JSON.stringify(id)} was not found in project ${JSON.stringify(projectId)}.`);
+		return record;
+	} finally { db.close(); }
+}
+
+/**
