+function dedupeDeepestDirs(dirs: readonly string[]): string[] {
+	const kept: string[] = [];
+	const sorted = [...dirs].sort((a, b) => b.length - a.length);
+	for (const candidate of sorted) {
+		if (kept.some(deeper => isWithinOrEqual(candidate, deeper))) continue;
+		kept.push(candidate);
+	}
+	return dirs.filter(dir => kept.includes(dir)).slice(0, MAX_TARGET_REPO_DIRS);
