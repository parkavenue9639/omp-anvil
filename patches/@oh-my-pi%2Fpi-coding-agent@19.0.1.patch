+import { createHash } from "node:crypto";
+import { basename } from "node:path";
+import type { Settings } from "../config/settings";
+import { listRegisteredRoutingProjects } from "./projects";
+import { redactRoutingSecrets } from "./redact";
+import { cfgMemoryRoutingCrossProjectRead, cfgMemoryRoutingEnabled } from "./settings";
+import type { MemoryProjectEntrypoint, MemoryProjectRelation, MemoryRoutingProject } from "./types";
+
+export interface MemoryProjectDirectoryRelation extends MemoryProjectRelation {
+	/** Whether this exact target is currently registered; not a dependency verification. */
+	available: boolean;
+}
+
+export interface MemoryProjectDirectoryEntry {
+	id: string;
+	name: string;
+	roots: string[];
+	description: string;
+	aliases: string[];
+	entrypoints: MemoryProjectEntrypoint[];
+	relations: MemoryProjectDirectoryRelation[];
+	readUrl: string;
+	/** Field paths whose descriptive text or lists were shortened for the response budget. */
+	truncated?: string[];
+}
+
+export interface MemoryProjectListOptions {
+	query?: string;
+	cursor?: string;
+	limit?: number;
+}
+
+export interface MemoryProjectPage {
+	projects: MemoryProjectDirectoryEntry[];
+	nextCursor?: string;
+	/** Bounded notices about registrations that cannot be safely projected; never includes their values. */
+	warnings?: string[];
+}
+
+const RESPONSE_BUDGET = 16_384;
+const ENTRY_BUDGET = 14_000;
+const UNSAFE_IDENTITY_WARNING = "One or more registered projects could not be safely displayed because their identity text requires redaction.";
+
+class UnsafeProjectIdentityError extends Error {}
+
+/** Profile-scoped directory, never fact content and never a registry discovery operation. */
+export function listMemoryProjects(settings: Settings, options: MemoryProjectListOptions = {}): MemoryProjectPage {
+	const catalog = directoryCatalog(settings);
+	const limit = options.limit ?? 5;
+	if (!Number.isSafeInteger(limit) || limit < 1 || limit > 10) {
+		throw new Error("Project directory limit must be an integer from 1 to 10");
+	}
+	if (options.query !== undefined && (typeof options.query !== "string" || options.query.length > 4_000)) {
+		throw new Error("Project directory query must be a string of at most 4000 characters");
+	}
+	const query = (options.query ?? "").trim().toLowerCase().replace(/\s+/g, " ");
+	const matches = catalog.filter(project => [project.id, projectName(project), project.description, ...(project.aliases ?? [])]
+		.some(value => sanitize(value).toLowerCase().replace(/\s+/g, " ").includes(query)));
+	const binding = digest(JSON.stringify({ query, catalog }));
+	let offset = options.cursor === undefined ? 0 : decodeCursor(options.cursor, binding, matches.length);
+	const registered = new Set(catalog.map(project => project.id));
+	const page: MemoryProjectPage = { projects: [] };
+	while (offset < matches.length && page.projects.length < limit) {
+		let entry: MemoryProjectDirectoryEntry;
+		try {
+			entry = boundedEntry(matches[offset]!, registered, false);
+		} catch (error) {
+			if (!(error instanceof UnsafeProjectIdentityError)) throw error;
+			page.warnings ??= [UNSAFE_IDENTITY_WARNING];
+			offset++;
+			continue;
+		}
+		const nextOffset = offset + 1;
+		const nextCursor = nextOffset < matches.length ? encodeCursor(binding, nextOffset) : undefined;
+		const candidate: MemoryProjectPage = {
+			projects: [...page.projects, entry], ...(nextCursor ? { nextCursor } : {}),
+			// Reserve the bounded warning even if an unsafe registration appears later in this page.
+			warnings: [UNSAFE_IDENTITY_WARNING],
+		};
+		if (JSON.stringify(candidate).length > RESPONSE_BUDGET) {
+			if (page.projects.length === 0) throw new Error("Project metadata exceeds the directory response budget");
+			break;
+		}
+		page.projects.push(entry);
+		offset = nextOffset;
+	}
+	if (offset < matches.length) page.nextCursor = encodeCursor(binding, offset);
+	return page;
+}
+
+export function getMemoryProject(settings: Settings, projectId: string): MemoryProjectDirectoryEntry {
+	const catalog = directoryCatalog(settings);
+	if (typeof projectId !== "string" || !projectId || projectId !== projectId.trim()) {
+		throw new Error("An exact registered project ID is required");
+	}
+	const project = catalog.find(candidate => candidate.id === projectId);
+	if (!project) throw new Error("Unknown or unavailable memory project");
+	return boundedEntry(project, new Set(catalog.map(candidate => candidate.id)), true);
+}
+
+function directoryCatalog(settings: Settings): MemoryRoutingProject[] {
+	if (!cfgMemoryRoutingEnabled.get(settings) || !cfgMemoryRoutingCrossProjectRead.get(settings)) {
+		throw new Error("Cross-project memory navigation is disabled");
+	}
+	try {
+		return listRegisteredRoutingProjects(settings).sort((left, right) => left.id < right.id ? -1 : left.id > right.id ? 1 : 0);
+	} catch (error) {
+		const message = error instanceof Error ? error.message : "Unknown catalog failure";
+		throw new Error(`Cannot read project directory: ${sanitize(message).slice(0, 1_000)}`);
+	}
+}
+
+function projectName(project: MemoryRoutingProject): string {
+	return project.name ?? (basename(project.roots[0] ?? "") || project.id);
+}
+
+/** Shared with classifier input and explicit memory reads, before any clipping. */
+function sanitize(value: string): string {
+	return redactRoutingSecrets(value);
+}
+
+function exactIdentity(value: string): string {
+	if (sanitize(value) !== value || value.includes("\0")) {
+		throw new UnsafeProjectIdentityError("Project identity contains sensitive or invalid text and cannot be safely displayed");
+	}
+	return value;
+}
+
+function boundedEntry(project: MemoryRoutingProject, registered: Set<string>, detail: boolean): MemoryProjectDirectoryEntry {
+	const id = exactIdentity(project.id);
+	// Every profile clips only descriptive fields/lists. Identity and detail URLs remain exact.
+	for (let scale = 1; scale <= 32; scale *= 2) {
+		const truncated = new Set<string>();
+		const clip = (value: string, field: string, size: number): string => {
+			const safe = sanitize(value);
+			const max = Math.max(48, Math.floor(size / scale));
+			if (safe.length <= max) return safe;
+			truncated.add(field);
+			return `${safe.slice(0, max - 1)}…`;
+		};
+		const take = <T>(values: T[], field: string, size: number): T[] => {
+			const max = Math.max(1, Math.floor(size / scale));
+			if (values.length > max) truncated.add(field);
+			return values.slice(0, max);
+		};
+		const entry: MemoryProjectDirectoryEntry = {
+			id,
+			name: clip(projectName(project), "name", 200),
+			roots: take(project.roots, "roots", detail ? 16 : 4).map(root => clip(root, "roots", 600)),
+			description: clip(project.description, "description", detail ? 4_000 : 800),
+			aliases: take(project.aliases ?? [], "aliases", detail ? 32 : 8).map(alias => clip(alias, "aliases", 160)),
+			entrypoints: take(project.entrypoints ?? [], "entrypoints", detail ? 20 : 4).map(item => ({
+				path: clip(item.path, "entrypoints.path", 600),
+				...(item.summary === undefined ? {} : { summary: clip(item.summary, "entrypoints.summary", detail ? 800 : 240) }),
+			})),
+			relations: take(project.relations ?? [], "relations", detail ? 20 : 4).map(item => ({
+				projectId: exactIdentity(item.projectId),
+				kind: item.kind,
+				status: item.status,
+				summary: clip(item.summary, "relations.summary", detail ? 800 : 240),
+				sources: take(item.sources, "relations.sources", detail ? 8 : 3)
+					.map(source => clip(source, "relations.sources", 600)),
+				available: registered.has(item.projectId),
+			})),
+			readUrl: `memory://projects/${encodeURIComponent(id)}`,
+			...(truncated.size ? { truncated: [...truncated].sort() } : {}),
+		};
+		if (JSON.stringify(entry).length <= ENTRY_BUDGET) return entry;
+	}
+	throw new Error("Project identity or metadata exceeds the bounded directory response; registration must be shortened");
+}
+
+function digest(value: string): string {
+	return createHash("sha256").update(value).digest("hex");
+}
+
+function encodeCursor(binding: string, offset: number): string {
+	return Buffer.from(JSON.stringify({ v: 1, binding, offset, check: digest(`${binding}:${offset}`) })).toString("base64url");
+}
+
+function decodeCursor(cursor: string, binding: string, total: number): number {
+	if (typeof cursor !== "string" || !cursor || cursor.length > 1_024 || !/^[A-Za-z0-9_-]+$/.test(cursor)) {
+		throw new Error("Malformed project directory cursor");
+	}
+	try {
+		const text = Buffer.from(cursor, "base64url").toString("utf8");
+		if (Buffer.from(text).toString("base64url") !== cursor) throw new Error("encoding");
+		const value: unknown = JSON.parse(text);
+		if (typeof value !== "object" || value === null || Array.isArray(value)) throw new Error("shape");
+		const token = value as Record<string, unknown>;
+		if (Object.keys(token).length !== 4 || token.v !== 1 || token.binding !== binding
+			|| typeof token.offset !== "number" || !Number.isSafeInteger(token.offset) || token.offset < 1 || token.offset >= total
+			|| token.check !== digest(`${binding}:${token.offset}`)) throw new Error("binding or range");
+		return token.offset;
+	} catch {
+		throw new Error("Invalid, mismatched, or stale project directory cursor; restart the directory query");
+	}
+}
diff --git a/src/memory-routing/project-registry.ts b/src/memory-routing/project-registry.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e9243a96a53f3da05a1678751ae69eba155ac3ce
--- /dev/null
+++ b/src/memory-routing/project-registry.ts
@@ -0,0 +1,136 @@
+import { Database } from "bun:sqlite";
+import { createHash } from "node:crypto";
+import { chmodSync, closeSync, constants, existsSync, fstatSync, mkdirSync, openSync, readSync, realpathSync } from "node:fs";
+import { basename, dirname, join, resolve } from "node:path";
+import * as vcs from "@oh-my-pi/pi-natives/vcs";
+import { getMemoriesDir } from "@oh-my-pi/pi-utils";
+import { redactRoutingSecrets } from "./redact";
+import type { MemoryRoutingProject } from "./types";
+
+interface ProjectRow {
+	id: string;
+	root: string;
+	description: string;
+}
+
+/** Profile identity catalog, deliberately independent of any fact-store/ledger namespace. */
+function openCatalog(agentDir: string): Database {
+	const filename = join(getMemoriesDir(agentDir), "routing", "projects.db");
+	const creating = !existsSync(filename);
+	if (creating) mkdirSync(dirname(filename), { recursive: true, mode: 0o700 });
+	const db = new Database(filename, { create: true });
+	try {
+		if (creating) chmodSync(filename, 0o600);
+		db.exec("PRAGMA busy_timeout = 5000");
+		const version = db.query<{ user_version: number }, []>("PRAGMA user_version").get()?.user_version;
+		if (version === 0) {
+			db.transaction(() => {
+				db.exec(`CREATE TABLE IF NOT EXISTS projects (
+					id TEXT PRIMARY KEY,
+					common_dir TEXT NOT NULL UNIQUE,
+					root TEXT NOT NULL,
+					description TEXT NOT NULL
+				);
+				PRAGMA user_version = 1;`);
+			}).immediate();
+		} else if (version !== 1) {
+			throw new Error(`Unsupported automatic memory project catalog version: ${version}`);
+		}
+		return db;
+	} catch (error) {
+		db.close();
+		throw error;
+	}
+}
+
+function project(row: ProjectRow): MemoryRoutingProject {
+	return { id: row.id, roots: [row.root], description: row.description };
+}
+
+export function listAutomaticRoutingProjects(
+	agentDir: string,
+	options: { readonly?: boolean } = {},
+): MemoryRoutingProject[] {
+	const filename = join(getMemoriesDir(agentDir), "routing", "projects.db");
+	if (options.readonly && !existsSync(filename)) return [];
+	const db = options.readonly ? new Database(filename, { readonly: true }) : openCatalog(agentDir);
+	try {
+		if (options.readonly && db.query<{ user_version: number }, []>("PRAGMA user_version").get()?.user_version !== 1) {
+			throw new Error("Unsupported automatic memory project catalog version");
+		}
+		return db.query<ProjectRow, []>("SELECT id, root, description FROM projects ORDER BY id").all().map(project);
+	} finally {
+		db.close();
+	}
+}
+
+/** No directory ancestry/remote heuristic: only canonical shared Git metadata identifies a project. */
+export function discoverAutomaticRoutingProject(agentDir: string, cwd: string): MemoryRoutingProject | undefined {
+	if (!cwd.trim()) return undefined;
+	const repository = vcs.repo(resolve(cwd));
+	const git = repository?.asGit();
+	if (!repository || !git) return undefined;
+	const commonDir = realpathSync.native(git.info().commonDir);
+	const db = openCatalog(agentDir);
+	try {
+		const lookup = db.query<ProjectRow, [string]>("SELECT id, root, description FROM projects WHERE common_dir = ?");
+		const existing = lookup.get(commonDir);
+		if (existing) return project(existing);
+		const root = realpathSync.native(repository.primaryRoot());
+		const id = `auto-${createHash("sha256").update(commonDir).digest("hex")}`;
+		const description = describeRepository(root);
+		// The unique repository key arbitrates first discovery by concurrent worktrees/processes.
+		db.query("INSERT INTO projects (id, common_dir, root, description) VALUES (?, ?, ?, ?) ON CONFLICT(common_dir) DO NOTHING")
+			.run(id, commonDir, root, description);
+		const registered = lookup.get(commonDir);
+		if (!registered) throw new Error("Automatic memory project registration did not persist");
+		return project(registered);
+	} finally {
+		db.close();
+	}
+}
+
+/** Read only a small regular file, never follow repository-controlled metadata symlinks. */
+function readMetadata(filename: string, maxBytes: number, requireComplete = false): string | undefined {
+	let fd: number | undefined;
+	try {
+		fd = openSync(filename, constants.O_RDONLY | constants.O_NOFOLLOW | constants.O_NONBLOCK);
+		const stat = fstatSync(fd);
+		if (!stat.isFile() || (requireComplete && stat.size > maxBytes)) return undefined;
+		const buffer = Buffer.allocUnsafe(Math.min(stat.size, maxBytes));
+		const count = readSync(fd, buffer, 0, buffer.length, 0);
+		return buffer.toString("utf8", 0, count);
+	} catch {
+		return undefined;
+	} finally {
+		if (fd !== undefined) closeSync(fd);
+	}
+}
+
+function describeRepository(root: string): string {
+	const parts = [`Git project ${basename(root)} at ${root}.`];
+	const json = readMetadata(join(root, "package.json"), 32_768, true);
+	if (json !== undefined) {
+		try {
+			const value: unknown = JSON.parse(json);
+			if (typeof value === "object" && value !== null && !Array.isArray(value)) {
+				for (const [key, limit] of [["name", 160], ["description", 800]] as const) {
+					const field = key in value ? (value as Record<string, unknown>)[key] : undefined;
+					if (typeof field === "string" && field.trim()) {
+						parts.push(`Package ${key}: ${redactRoutingSecrets(field.trim()).slice(0, limit)}`);
+					}
+				}
+			}
+		} catch {
+			// Optional malformed metadata never prevents an otherwise valid Git identity.
+		}
+	}
+	for (const name of ["README.md", "README", "readme.md"]) {
+		const readme = readMetadata(join(root, name), 16_384);
+		if (readme === undefined) continue;
+		const intro = redactRoutingSecrets(readme).trim().split(/\r?\n/).slice(0, 16).join("\n").slice(0, 1_200);
+		if (intro) parts.push(`README introduction: ${intro}`);
+		break;
+	}
+	return redactRoutingSecrets(parts.join("\n"));
+}
diff --git a/src/memory-routing/projects.ts b/src/memory-routing/projects.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0541c1da165a54272cd1672e2f3508e416ee0113
--- /dev/null
+++ b/src/memory-routing/projects.ts
@@ -0,0 +1,203 @@
+import { createHash } from "node:crypto";
+import { realpathSync } from "node:fs";
+import * as path from "node:path";
+import * as vcs from "@oh-my-pi/pi-natives/vcs";
+import type { Settings } from "../config/settings";
+import { discoverAutomaticRoutingProject, listAutomaticRoutingProjects } from "./project-registry";
+import { cfgMemoryRoutingAutoRegisterProjects, cfgMemoryRoutingEnabled, cfgMemoryRoutingProjects } from "./settings";
+import type { MemoryRoutingProject } from "./types";
+
+/** Manual registrations remain authoritative; discovery never rewrites profile settings. */
+export function listRoutingProjects(settings: Settings): MemoryRoutingProject[] {
+	const manual = manualProjects(settings);
+	if (!cfgMemoryRoutingEnabled.get(settings) || !cfgMemoryRoutingAutoRegisterProjects.get(settings)) return manual;
+	const current = matchManualProject(manual, settings.getCwd());
+	if (!current.match && !current.ambiguous) discoverAutomaticRoutingProject(settings.getAgentDir(), settings.getCwd());
+	return mergeProjects(manual, listAutomaticRoutingProjects(settings.getAgentDir()));
+}
+
+/** Directory reads existing registrations only; they never discover or create a catalog. */
+export function listRegisteredRoutingProjects(settings: Settings): MemoryRoutingProject[] {
+	const manual = manualProjects(settings);
+	if (!cfgMemoryRoutingEnabled.get(settings) || !cfgMemoryRoutingAutoRegisterProjects.get(settings)) return manual;
+	return mergeProjects(manual, listAutomaticRoutingProjects(settings.getAgentDir(), { readonly: true }));
+}
+
+function mergeProjects(manual: MemoryRoutingProject[], automatic: MemoryRoutingProject[]): MemoryRoutingProject[] {
+	const manualIds = new Set(manual.map(project => project.id));
+	const visible = automatic.filter(project => !manualIds.has(project.id) && project.roots.every(root => {
+		const coverage = matchManualProject(manual, root);
+		return !coverage.match && !coverage.ambiguous;
+	}));
+	// Hide superseded automatic targets without deleting or migrating their stored data.
+	return [...manual, ...visible];
+}
+
+
+function manualProjects(settings: Settings): MemoryRoutingProject[] {
+	const record: unknown = cfgMemoryRoutingProjects.get(settings);
+	if (typeof record !== "object" || record === null || Array.isArray(record)) {
+		throw new Error("memoryRouting.projects must be a project-id record");
+	}
+	return Object.entries(record).map(([id, value]) => {
+		if (!id.trim() || id !== id.trim() || typeof value !== "object" || value === null || Array.isArray(value)) {
+			throw new Error(`Invalid memoryRouting project registration: ${JSON.stringify(id)}`);
+		}
+		const roots: unknown = "roots" in value ? value.roots : undefined;
+		const description: unknown = "description" in value ? value.description : undefined;
+		if (!Array.isArray(roots) || roots.length === 0 || roots.some(root =>
+			typeof root !== "string" || !root.trim() || !path.isAbsolute(root) || root.includes("\0"))) {
+			throw new Error(`memoryRouting.projects.${id}.roots must contain absolute root paths`);
+		}
+		if (typeof description !== "string" || !description.trim()) {
+			throw new Error(`memoryRouting.projects.${id}.description must be nonempty`);
+		}
+		const project: MemoryRoutingProject = {
+			id, roots: [...new Set((roots as string[]).map(normalizeRoot))], description: description.trim(),
+		};
+		const metadata = value as Record<string, unknown>;
+		if (metadata.name !== undefined) project.name = nonempty(metadata.name, "name");
+		if (metadata.aliases !== undefined) project.aliases = stringList(metadata.aliases, "aliases");
+		if (metadata.entrypoints !== undefined) {
+			if (!Array.isArray(metadata.entrypoints)) throw new Error("Project entrypoints must be an array");
+			project.entrypoints = metadata.entrypoints.map(entry => {
+				const item = objectValue(entry, "entrypoint");
+				return {
+					path: nonempty(item.path, "entrypoint.path"),
+					...(item.summary === undefined ? {} : { summary: nonempty(item.summary, "entrypoint.summary") }),
+				};
+			});
+		}
+		if (metadata.relations !== undefined) {
+			if (!Array.isArray(metadata.relations)) throw new Error("Project relations must be an array");
+			project.relations = metadata.relations.map(relation => {
+				const item = objectValue(relation, "relation");
+				const projectId = nonempty(item.projectId, "relation.projectId");
+				if (projectId !== item.projectId) throw new Error("Relation projectId must be an exact project identity");
+				if (item.kind !== "uses" && item.kind !== "used-by" && item.kind !== "related") {
+					throw new Error("Invalid project relation kind");
+				}
+				if (item.status !== "documented" && item.status !== "design" && item.status !== "historical") {
+					throw new Error("Project relation requires an explicit evidence status");
+				}
+				const sources = stringList(item.sources, "relation.sources");
+				if (sources.length === 0) throw new Error("Project relation requires evidence sources");
+				return {
+					projectId, kind: item.kind, status: item.status,
+					summary: nonempty(item.summary, "relation.summary"), sources,
+				};
+			});
+		}
+		return project;
+	});
+}
+
+function objectValue(value: unknown, field: string): Record<string, unknown> {
+	if (typeof value !== "object" || value === null || Array.isArray(value)) {
+		throw new Error(`Project ${field} must be an object`);
+	}
+	return value as Record<string, unknown>;
+}
+
+function nonempty(value: unknown, field: string): string {
+	if (typeof value !== "string" || !value.trim() || value.includes("\0")) {
+		throw new Error(`Project ${field} must be a nonempty string without NUL`);
+	}
+	return value.trim();
+}
+
+function stringList(value: unknown, field: string): string[] {
+	if (!Array.isArray(value)) throw new Error(`Project ${field} must be an array of strings`);
+	return [...new Set(value.map(item => nonempty(item, field)))];
+}
+
+export function routingProjectById(settings: Settings, id: string): MemoryRoutingProject | undefined {
+	return listRoutingProjects(settings).find(project => project.id === id);
+}
+
+/**
+ * Match registered roots/descendants, mapping linked worktrees through the native
+ * VCS primary root. Relative paths are preserved: registering a monorepo package
+ * does not implicitly register every other package in that repository.
+ */
+export function resolveRoutingProject(settings: Settings, cwd: string): MemoryRoutingProject | undefined {
+	const manual = manualProjects(settings);
+	const result = matchManualProject(manual, cwd);
+	if (result.match || result.ambiguous
+		|| !cfgMemoryRoutingEnabled.get(settings) || !cfgMemoryRoutingAutoRegisterProjects.get(settings)) return result.match;
+	return discoverAutomaticRoutingProject(settings.getAgentDir(), cwd);
+}
+
+function matchManualProject(
+	projects: MemoryRoutingProject[],
+	cwd: string,
+): { match?: MemoryRoutingProject; ambiguous: boolean } {
+	if (!cwd.trim() || projects.length === 0) return { ambiguous: false };
+	const directory = normalizeRoot(cwd);
+	const primaryDirectory = primaryPath(directory);
+	let match: MemoryRoutingProject | undefined;
+	let specificity = Number.NEGATIVE_INFINITY;
+	let ambiguous = false;
+	for (const project of projects) {
+		for (const root of project.roots) {
+			const primaryRoot = primaryPath(root);
+			const score = Math.max(
+				isWithin(root, directory) ? -path.relative(root, directory).length : Number.NEGATIVE_INFINITY,
+				isWithin(primaryRoot, primaryDirectory)
+					? -path.relative(primaryRoot, primaryDirectory).length
+					: Number.NEGATIVE_INFINITY,
+			);
+			if (!Number.isFinite(score) || score < specificity) continue;
+			if (score > specificity) {
+				match = project;
+				specificity = score;
+				ambiguous = false;
+			} else if (match?.id !== project.id) {
+				ambiguous = true;
+			}
+		}
+	}
+	return { match: ambiguous ? undefined : match, ambiguous };
+}
+
+/** Stable, bounded bank name; sanitization never merges distinct project IDs. */
+export function routingProjectBank(configuredBase: string | undefined, projectId: string): string {
+	if (!projectId.trim() || projectId !== projectId.trim()) throw new Error("A registered project ID is required");
+	const digest = createHash("sha256").update(projectId).digest("hex").slice(0, 16);
+	const base = bankSegment(configuredBase ?? "") || "default";
+	const project = bankSegment(projectId) || "project";
+	const prefix = `${base}-project-${project}`.slice(0, 47).replace(/-+$/g, "");
+	return `${prefix}-${digest}`;
+}
+
+function normalizeRoot(root: string): string {
+	const absolute = path.resolve(root);
+	try {
+		return realpathSync.native(absolute);
+	} catch {
+		// Preserve canonical parent identity even for a not-yet-created descendant.
+		const parent = path.dirname(absolute);
+		return parent === absolute ? absolute : path.join(normalizeRoot(parent), path.basename(absolute));
+	}
+}
+
+function primaryPath(directory: string): string {
+	try {
+		const repository = vcs.repo(directory);
+		if (!repository) return directory;
+		const root = normalizeRoot(repository.root());
+		if (!isWithin(root, directory)) return directory;
+		return path.resolve(normalizeRoot(repository.primaryRoot()), path.relative(root, directory));
+	} catch {
+		return directory;
+	}
+}
+
+function isWithin(root: string, directory: string): boolean {
+	const relative = path.relative(root, directory);
+	return relative === "" || (relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative));
+}
+
+function bankSegment(value: string): string {
+	return value.trim().replace(/[^a-zA-Z0-9_-]+/g, "-").replace(/^-+|-+$/g, "");
+}
diff --git a/src/memory-routing/redact.ts b/src/memory-routing/redact.ts
