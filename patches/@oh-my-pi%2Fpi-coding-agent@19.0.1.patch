+		!(
+			typeof rawModel === "string" ||
+			(Array.isArray(rawModel) && rawModel.length === 1 && typeof rawModel[0] === "string")
+		)
+	) {
+		throw new Error(`Managed preset "${fields.name}" requires exactly one pure @role selector.`);
+	}
+	for (const key of ["thinking", "thinkingLevel", "effort", "prewalk", "advisor"]) {
+		if (Object.hasOwn(frontmatter, key)) {
+			throw new Error(`Managed preset "${fields.name}" cannot declare ${key}; its role owns the execution plan.`);
+		}
+	}
+	if (fields.spawns === "*" || (fields.spawns?.length ?? 0) > 0) {
+		throw new Error(`Managed preset "${fields.name}" cannot spawn nested agents.`);
+	}
+	if (
+		Object.hasOwn(frontmatter, "spawns") &&
+		!(Array.isArray(frontmatter.spawns) && frontmatter.spawns.length === 0)
+	) {
+		throw new Error(`Managed preset "${fields.name}" must omit spawns or declare [].`);
+	}
