+// Validate the managed preset contract without duplicating its role bindings:
+// intentional rebinding to another pure role is supported.
+const MANAGED_PRESET_NAMES: Record<string, true> = {
+	scout: true,
+	fast: true,
+	routine: true,
+	task: true,
+	engineer: true,
+	deep: true,
+	review: true,
+	security: true,
+	visual: true,
+	"visual-edit": true,
+	creative: true,
+	"frontend-engineer": true,
+};
+
+export function isManagedPresetName(name: string): boolean {
+	return Object.hasOwn(MANAGED_PRESET_NAMES, name);
+}
+
+/** Return the effective managed role, rejecting overrides that replace its role plan. */
+export function resolveManagedPresetRole(
+	agent: Pick<AgentDefinition, "name" | "model">,
+	settingsOverride?: string | string[],
+): string | undefined {
+	if (!isManagedPresetName(agent.name)) return undefined;
+	const selectors =
+		settingsOverride === undefined
+			? agent.model
+			: typeof settingsOverride === "string"
+				? [settingsOverride]
+				: settingsOverride;
+	if (
+		(settingsOverride !== undefined && typeof settingsOverride !== "string") ||
+		selectors?.length !== 1 ||
+		!/^@[A-Za-z0-9_-]+$/.test(selectors[0]!)
+	) {
+		throw new Error(
+			`Managed preset "${agent.name}" requires exactly one pure @role selector${settingsOverride === undefined ? "" : " in task.agentModelOverrides"}.`,
+		);
+	}
+	return selectors[0];
