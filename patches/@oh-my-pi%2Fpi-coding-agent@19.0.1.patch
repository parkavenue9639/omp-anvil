+import { realpathSync } from "node:fs";
+import { basename, dirname, join } from "node:path";
+import type { SessionManager } from "./session-manager";
+import type { SessionEntry } from "./session-entries";
+
+/** Native Source DTO; business project association remains an Engine-owned fact. */
+export interface NativeSourceEvent {
+	version: 1; id: string; seq: number;
+	kind: "started" | "busy" | "turn-ended" | "idle" | "exited" | "project-changed" | "title-changed";
+	at: string;
+	native: { sessionId: string; sessionFile: string; cwd: string; hostInstanceId: string };
+	loopId?: string; turnIndex?: number; nativeEntryId?: string;
+	activity?: { state: "busy" | "idle" | "stopped" | "switched"; pendingMessages: boolean | null;
+		runningJobs: number | null; willContinue?: boolean; awaitingAsyncWork?: boolean };
+	project?: { projectIds: string[]; primaryProjectId?: string; state: "associated" | "unassigned" | "conflict" | "non-project";
+		origin: "automatic" | "explicit" | "inherited" | "correction"; reason?: string };
+	title?: string; exitReason?: "shutdown" | "switched";
+}
+export interface NativeSourcePage {
+	sourceId: string; events: NativeSourceEvent[]; nextSeq: number; latestSeq: number; hasMore: boolean;
+}
+
+/** Populated by the trusted Source producer, independently of executor/Router target binding. */
+export class ExecutorSourceEvents {
+	#events: NativeSourceEvent[] = [];
+	#byId = new Map<string, NativeSourceEvent>();
+	readonly #sessionId: string;
+	constructor(private readonly manager: SessionManager, entries: readonly SessionEntry[] = manager.getEntries()) {
+		this.#sessionId = manager.getSessionId();
+		for (const entry of entries) {
+			if (entry.type !== "custom" || entry.customType !== "lcp-source-event") continue;
+			const event = entry.data as NativeSourceEvent;
+			if (event.seq !== this.#events.length + 1) throw new Error("SOURCE_EVENT_GAP");
+			this.#events.push(event); this.#byId.set(event.id, event);
+		}
+	}
+	appendSourceEvent(event: NativeSourceEvent): NativeSourceEvent {
+		if (this.manager.getSessionId() !== this.#sessionId) throw new Error("EXECUTOR_SESSION_SWITCHED");
+		const previous = this.#byId.get(event.id);
+		if (previous) {
+			if (JSON.stringify(previous) !== JSON.stringify(event)) throw new Error("SOURCE_EVENT_ID_CONFLICT");
+			return structuredClone(previous);
+		}
+		if (event.version !== 1 || !event.id || !Number.isSafeInteger(event.seq) || event.seq !== this.#events.length + 1 ||
+			event.native.sessionId !== this.#sessionId || event.native.sessionFile !==
+				join(realpathSync(dirname(this.manager.getSessionFile()!)), basename(this.manager.getSessionFile()!)) ||
+			Buffer.byteLength(JSON.stringify(event)) > 8192) throw new Error("INVALID_SOURCE_EVENT");
+		// Source is metadata, never a business Input or an implicit target bind.
+		const snapshot = structuredClone(event);
+		this.manager.appendExecutorRecord("lcp-source-event", snapshot);
+		this.#events.push(snapshot); this.#byId.set(event.id, snapshot);
+		return structuredClone(snapshot);
+	}
+	getSourceEvents(request: { afterSeq: number; limit?: number; maxBytes?: number }): NativeSourcePage {
+		if (this.manager.getSessionId() !== this.#sessionId) throw new Error("EXECUTOR_SESSION_SWITCHED");
+		const { afterSeq, limit = 128, maxBytes = 262144 } = request;
+		if (!Number.isSafeInteger(afterSeq) || afterSeq < 0 || !Number.isInteger(limit) || limit < 1 || limit > 128 ||
+			!Number.isInteger(maxBytes) || maxBytes < 8192 || maxBytes > 262144) throw new Error("INVALID_SOURCE_CURSOR");
+		if (afterSeq > this.#events.length) throw new Error("SOURCE_CURSOR_AHEAD");
+		const result: NativeSourcePage = { sourceId: this.#sessionId, events: [], nextSeq: afterSeq,
+			latestSeq: this.#events.length, hasMore: afterSeq < this.#events.length };
+		for (let index = afterSeq; index < Math.min(afterSeq + limit, this.#events.length); index++) {
+			const event = this.#events[index]!;
+			if (event.seq !== result.nextSeq + 1) throw new Error("SOURCE_EVENT_GAP");
+			result.events.push(event); const previous = result.nextSeq; result.nextSeq = event.seq; result.hasMore = event.seq < result.latestSeq;
+			if (Buffer.byteLength(JSON.stringify(result)) > maxBytes) {
+				result.events.pop(); result.nextSeq = previous; result.hasMore = true;
+				if (!result.events.length) throw new Error("SOURCE_EVENT_PAGE_TOO_SMALL");
+				break;
+			}
+		}
+		return structuredClone(result);
+	}
+}
