@@ -0,0 +1,80 @@
+import { classifyMemoryWrite, pendingMemoryDecision, validateMemoryRoutingDecisions } from "./classifier";
+import {
+	getMemoryRoutingFact, getMemoryRoutingStatus, saveMemoryRoutingFact, saveMemoryRoutingStatus, withMemoryRoutingLock,
+} from "./ledger";
+import type { MemoryRoutingCommit, MemoryRoutingContext, MemoryRoutingDecision, MemoryRoutingInput, MemoryRoutingOutcome, MemoryRoutingStored } from "./types";
+
+export { classifyMemoryWrite } from "./classifier";
+
+function validStored(stored: MemoryRoutingStored, decision: MemoryRoutingDecision): boolean {
+	return typeof stored?.id === "string" && !!stored.id.trim() && typeof stored.bank === "string" && !!stored.bank.trim() &&
+		stored.scope === decision.scope && stored.projectId === decision.projectId;
+}
+
+/** Commit reviewed decisions without reclassification. Successful atomic facts survive partial retries. */
+export async function commitMemoryDecisions(
+	context: MemoryRoutingContext, input: MemoryRoutingInput, decisions: MemoryRoutingDecision[], commit: MemoryRoutingCommit,
+): Promise<MemoryRoutingOutcome> {
+	try {
+		return await withMemoryRoutingLock(context.agentDir, async () => {
+			const previous = getMemoryRoutingStatus(context, input);
+			if (previous?.status === "completed") {
+				return { sourceId: input.sourceId, decisions: previous.decisions, stored: previous.stored, pending: false };
+			}
+			const validated = validateMemoryRoutingDecisions(context, input, decisions);
+			const stored: MemoryRoutingStored[] = [];
+			let pending = validated.some(decision => decision.action === "pending");
+			let message: string | undefined;
+			// An interrupted/failed writer never appears completed. Persist safe decisions before any recall write.
+			saveMemoryRoutingStatus(context, input, { status: "pending", decisions: validated, stored });
+			for (const decision of validated) {
+				if (decision.action !== "store") continue;
+				if (context.signal?.aborted) {
+					pending = true;
+					message = "Memory commit was cancelled; retry required";
+					break;
+				}
+				try {
+					let result = getMemoryRoutingFact(context.agentDir, decision);
+					if (!result) {
+						result = await commit(decision);
+						if (!validStored(result, decision)) throw new Error("Invalid memory commit result");
+						saveMemoryRoutingFact(context.agentDir, decision, result);
+					}
+					if (!stored.some(item => item.bank === result.bank && item.id === result.id)) stored.push(result);
+				} catch {
+					pending = true;
+					message = "One or more memory commits failed; successful facts were retained and failed facts require retry";
+				}
+				// Persist partial progress so one rejected fact does not lose provenance of other successful facts.
+				saveMemoryRoutingStatus(context, input, { status: "pending", decisions: validated, stored, message });
+			}
+			saveMemoryRoutingStatus(context, input, { status: pending ? "pending" : "completed", decisions: validated, stored, message });
+			return { sourceId: input.sourceId, decisions: validated, stored, pending, ...(message ? { message } : {}) };
+		});
+	} catch {
+		return {
+			sourceId: input.sourceId, stored: [], pending: true,
+			decisions: [pendingMemoryDecision(input, "Memory routing ledger is unavailable; no successful completion recorded")],
+			message: "Memory routing ledger failed; review before retrying",
+		};
+	}
+}
+
+/** All automatic and explicit memory producers share this admission boundary. */
+export async function routeMemoryWrite(
+	context: MemoryRoutingContext, input: MemoryRoutingInput, commit: MemoryRoutingCommit,
+): Promise<MemoryRoutingOutcome> {
+	try {
+		const previous = getMemoryRoutingStatus(context, input);
+		if (previous?.status === "completed") {
+			return { sourceId: input.sourceId, decisions: previous.decisions, stored: previous.stored, pending: false };
+		}
+		// Reuse already reviewed/extracted facts after a failed write. Pure classification-pending batches can be reclassified.
+		const decisions = previous?.decisions.some(decision => decision.action === "store")
+			? previous.decisions : await classifyMemoryWrite(context, input);
+		return await commitMemoryDecisions(context, input, decisions, commit);
+	} catch {
+		return { sourceId: input.sourceId, stored: [], pending: true, decisions: [pendingMemoryDecision(input, "Memory routing unavailable; source was not admitted to recall")] };
+	}
+}
