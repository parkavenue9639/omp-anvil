+export async function recallProjectMemoriesStandalone(
+	settings: Settings, request: ProjectMemoryRecallRequest, options: ProjectMemoryStandaloneReadOptions = {},
+): Promise<MemoryBackendSearchResult> {
+	if (cfgMemoryBackend.get(settings) !== "mnemopi") throw new Error("Mnemopi is not the selected memory backend.");
+	if (!cfgMemoryRoutingEnabled.get(settings) || !cfgMemoryRoutingCrossProjectRead.get(settings)) {
+		throw new Error("Cross-project memory reads are disabled.");
+	}
+	const scoping = cfgMnemopiScoping.get(settings);
+	if (!["per-project", "per-project-tagged"].includes(scoping)) throw new Error("Cross-project reads require project-scoped Mnemopi.");
+	// Mirror the pinned native BeamMemory.normalizeConfig without opening an
+	// owner DB just to obtain scorer defaults. Foreign banks stay readonly.
+	const caller: ReadCaller = {
+		settings, scoping,
+		dbPath: cfgMnemopiDbPath.get(settings)?.trim() || join(getMemoriesDir(settings.getAgentDir()), "mnemopi", "mnemopi.db"),
+		baseBank: computeMnemopiBankScope(cfgMnemopiBank.get(settings), settings.getCwd(), scoping).baseBank,
+		beam: {
+			authorId: "coding-agent", authorType: "agent", useCloud: false,
+			config: {
+				workingMemoryLimit: 1000, workingMemoryTtlHours: 24, recencyHalflifeHours: 72,
+				vecWeight: nativeConfig.vectorWeight(), ftsWeight: nativeConfig.ftsWeight(), importanceWeight: nativeConfig.importanceWeight(),
+				useCloud: false, localLlmEnabled: false, maxEpisodeChars: nativeConfig.maxEpisodeChars(), proactiveLinking: false,
+				polyphonicRecall: cfgMnemopiPolyphonicRecall.get(settings), enhancedRecall: cfgMnemopiEnhancedRecall.get(settings),
+			},
+		},
+		runtimeOptions: {
+			embeddings: {
+				disabled: options.noInference === true || cfgMnemopiNoEmbeddings.get(settings),
+				model: cfgMnemopiEmbeddingModel.get(settings)?.trim() ||
+					(cfgMnemopiEmbeddingVariant.get(settings) === "multilingual" ? "intfloat/multilingual-e5-large" : "BAAI/bge-base-en-v1.5"),
+				apiUrl: cfgMnemopiEmbeddingApiUrl.get(settings), apiKey: cfgMnemopiEmbeddingApiKey.get(settings),
+			},
+			llm: { enabled: false }, debug: cfgMnemopiDebug.get(settings),
+		},
+	};
+	return recallWithCaller(settings, caller, request, options.noInference === true);
+}
