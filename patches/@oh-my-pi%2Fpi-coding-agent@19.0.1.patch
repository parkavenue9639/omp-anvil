diff --git a/src/config/role-fallbacks.ts b/src/config/role-fallbacks.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3c8db8a99614b2effe7bf53cacbb7e053548dd81
--- /dev/null
+++ b/src/config/role-fallbacks.ts
@@ -0,0 +1,23 @@
+import { MAX_THINKING_SUFFIX_OPTIONS, splitThinkingSuffix } from "@oh-my-pi/pi-tui/overlays/model-selector";
+
+/** Resolve only explicitly configured chains, inheriting a pure role alias's full plan. */
+export function resolveConfiguredRoleFallbackChain(
+	role: string,
+	chains: Readonly<Record<string, readonly string[]>>,
+	getModelRole: (role: string) => string | undefined,
+): readonly string[] | undefined {
+	const visited = new Set<string>();
+	let current = role;
+	while (true) {
+		if (visited.has(current)) throw new Error(`Model role alias cycle: ${[...visited, current].join(" -> ")}`);
+		visited.add(current);
+		if (Object.hasOwn(chains, current)) return chains[current];
+		const configured = getModelRole(current)?.trim();
+		if (!configured || configured.includes(",")) return undefined;
+		const { base } = splitThinkingSuffix(configured, configured.startsWith("pi/") ? 3 : 1, MAX_THINKING_SUFFIX_OPTIONS);
+		if (base === "*") current = "default";
+		else if (base.startsWith("@") && base.length > 1) current = base.slice(1);
+		else if (base.startsWith("pi/") && base.length > 3) current = base.slice(3);
+		else return undefined;
+	}
+}
diff --git a/src/config/startup-model-discovery.ts b/src/config/startup-model-discovery.ts
new file mode 100644
index 0000000000000000000000000000000000000000..33f3bb4ede6fde4ace75e4ee41f7ed93ccb54d18
--- /dev/null
+++ b/src/config/startup-model-discovery.ts
@@ -0,0 +1,40 @@
+import type { ModelRegistry } from "./model-registry";
+import { disabledProviderIds, resolveConfiguredModelPatterns, sessionModelDiscoveryProviders } from "./model-resolver";
+import type { Settings } from "./settings";
+
+/** Retry unresolved startup selectors without waiting for unrelated provider catalogs. */
+export async function resolveStartupModelWithDiscovery(
+	modelRegistry: ModelRegistry,
+	selectors: readonly string[],
+	settings: Settings,
+	// Index in the expanded selectors, from the caller's native resolver.
+	resolve: () => number | undefined | Promise<number | undefined>,
+): Promise<boolean> {
+	const patterns = resolveConfiguredModelPatterns([...selectors], settings);
+	let matchedIndex = await resolve();
+	const disabled = disabledProviderIds(settings);
+	for (let index = 0; index < patterns.length; index++) {
+		// A cached later match does not settle earlier, still-cold candidates.
+		if (matchedIndex !== undefined && index >= matchedIndex) return true;
+		const pattern = patterns[index];
+		const slash = pattern.indexOf("/");
+		const provider = slash < 0 ? undefined : modelRegistry.getDiscoveryProviderId(pattern.slice(0, slash));
+		if (!provider) {
+			// A slash may belong to a bare model id (org/model), not a provider.
+			await modelRegistry.refresh("online-if-uncached");
+			return (await resolve()) !== undefined;
+		}
+		const providers = sessionModelDiscoveryProviders(modelRegistry, [pattern], disabled);
+		if (providers.size === 0) continue;
+		await modelRegistry.refreshDiscoverableProviders(providers, "online-if-uncached");
+		matchedIndex = await resolve();
+		if (matchedIndex === undefined || matchedIndex > index) {
+			// Even a known prefix can be another provider's literal model id.
+			// Exhaust native cross-provider lookup before accepting a later
+			// candidate or falling back. A successful scoped match skips this.
+			await modelRegistry.refresh("online-if-uncached");
+			return (await resolve()) !== undefined;
+		}
+	}
+	return matchedIndex !== undefined;
+}
