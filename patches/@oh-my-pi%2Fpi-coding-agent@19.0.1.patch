new file mode 100644
index 0000000000000000000000000000000000000000..4dde374c59c3f76e64250f626442df9e655d27a0
--- /dev/null
+++ b/src/task/frontend-skills.ts
@@ -0,0 +1,54 @@
+import { dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { parseFrontmatter } from "@oh-my-pi/pi-utils";
+import type { Skill } from "../extensibility/skills";
+import engineeringText from "../skills/lcp-frontend-engineering/SKILL.md" with { type: "text" };
+import toolsText from "../skills/lcp-frontend-tools/SKILL.md" with { type: "text" };
+
+const FRONTEND_SKILL_NAMES: Record<string, true> = {
+	"lcp-frontend-engineering": true,
+	"lcp-frontend-tools": true,
+};
+
+let bundledSkills: readonly Skill[] | undefined;
+
+function frontendSkills(): readonly Skill[] {
+	if (bundledSkills) return bundledSkills;
+	bundledSkills = [
+		{ name: "lcp-frontend-engineering", content: engineeringText },
+		{ name: "lcp-frontend-tools", content: toolsText },
+	].map(({ name, content }) => {
+		const filePath = fileURLToPath(new URL(`../skills/${name}/SKILL.md`, import.meta.url));
+		const { frontmatter } = parseFrontmatter(content, { source: filePath, level: "off" });
+		if (frontmatter.name !== name || typeof frontmatter.description !== "string" || !frontmatter.description.trim()) {
+			throw new Error(`Invalid bundled frontend skill: ${name}`);
+		}
+		const baseDir = dirname(filePath);
+		return { name, description: frontmatter.description, filePath, baseDir, containRoot: baseDir, source: "lcp:bundled" };
+	});
+	return bundledSkills;
+}
+
+export function isFrontendSkillName(name: string): boolean {
+	return Object.hasOwn(FRONTEND_SKILL_NAMES, name);
+}
+
+/** Keep project skills intact while adding the two reserved, installation-relative frontend skills once. */
+export function withFrontendSkills(skills: Skill[] | undefined): Skill[] {
+	let merged: Skill[] | undefined;
+	for (const bundled of frontendSkills()) {
+		let existing: Skill | undefined;
+		if (skills) for (const skill of skills) {
+			if (skill.name !== bundled.name) continue;
+			if (existing) throw new Error(`Duplicate reserved frontend skill: ${bundled.name}`);
+			existing = skill;
+		}
+		if (existing) {
+			if (existing.filePath !== bundled.filePath) throw new Error(`Reserved frontend skill cannot be shadowed: ${bundled.name}`);
+			continue;
+		}
+		merged ??= skills ? [...skills] : [];
+		merged.push(bundled);
+	}
+	return merged ?? skills ?? [];
+}
