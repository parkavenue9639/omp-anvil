+import { register } from "../config/registry";
+import type { MemoryRoutingProject } from "./types";
+
+const PROJECTS: Record<string, Omit<MemoryRoutingProject, "id">> = {};
+
+export const cfgMemoryRoutingEnabled = register({ id: "memoryRouting.enabled", type: "boolean", default: false });
+export const cfgMemoryRoutingAutoRegisterProjects = register({
+	id: "memoryRouting.autoRegisterProjects", type: "boolean", default: false,
+});
+export const cfgMemoryRoutingCrossProjectRead = register({
+	id: "memoryRouting.crossProjectRead", type: "boolean", default: false,
+});
+export const cfgMemoryRoutingModel = register({ id: "memoryRouting.model", type: "string", default: "@memory" });
+export const cfgMemoryRoutingProjects = register({ id: "memoryRouting.projects", type: "record", default: PROJECTS });
+export const cfgMemoryRoutingOnUncertain = register({
+	id: "memoryRouting.onUncertain", type: "enum", values: ["pending"] as const, default: "pending",
+});
+export const cfgMemoryRoutingOnFailure = register({
+	id: "memoryRouting.onFailure", type: "enum", values: ["pending"] as const, default: "pending",
+});
+export const cfgMemoryRoutingTimeoutMs = register({
+	id: "memoryRouting.timeoutMs", type: "number", default: 120_000,
+	validate(value) {
+		if (value === undefined) return;
+		if (typeof value !== "number" || !Number.isInteger(value) || value < 1_000 || value > 600_000) {
+			throw new Error("memoryRouting.timeoutMs must be an integer from 1000 to 600000");
+		}
+	},
+});
+export const cfgMemoryRoutingMaxInputChars = register({
+	id: "memoryRouting.maxInputChars", type: "number", default: 200_000,
+	validate(value) {
+		if (value === undefined) return;
+		if (typeof value !== "number" || !Number.isInteger(value) || value < 1_000 || value > 1_000_000) {
+			throw new Error("memoryRouting.maxInputChars must be an integer from 1000 to 1000000");
+		}
+	},
+});
